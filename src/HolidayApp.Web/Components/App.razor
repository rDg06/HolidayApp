<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    <meta name="theme-color" content="#0f766e" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["HolidayApp.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="ClientOnly" />
</head>

<body>
    <div id="offline-banner" role="status" hidden>
        No internet connection: you are seeing the last version saved on this device. Changes are only saved when you are online.
    </div>

    <Routes @rendermode="ClientOnly" />

    <div id="blazor-error-ui">
        An unexpected error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss">✕</span>
    </div>

    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["js/pwa.js"]"></script>
</body>

</html>

@code {
    // The whole UI runs in the browser (no prerendering on the server),
    // so the pages always talk to the API over HTTP.
    private static readonly IComponentRenderMode ClientOnly = new InteractiveWebAssemblyRenderMode(prerender: false);
}
