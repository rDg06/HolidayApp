@* A place marker like the one on the map: number for visits, icon (house, plane, metro…) for the others. *@
@if (Place.IsVisit)
{
    <span class="place-number pin-small" title="@Display.Label(Place.Kind)">@Number</span>
}
else
{
    <span class="place-number pin-small @PlaceIcons.Css(Place.Kind)" title="@Display.Label(Place.Kind)"><PlaceIcon Kind="Place.Kind" /></span>
}

@code {
    [Parameter, EditorRequired] public PlanPlaceDto Place { get; set; } = default!;
    [Parameter] public int? Number { get; set; }
}
