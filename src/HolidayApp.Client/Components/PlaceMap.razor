@* Mapa com os locais a visitar: clicar no mapa ou procurar pelo nome para marcar. *@
@using System.Text.Json
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (Places.Count > 0)
{
    @* Filtro por dia: mostra só os locais desse dia e o alojamento dessa noite, no mapa e na lista *@
    <div class="day-filter" role="group" aria-label="Filtrar locais por dia">
        <button type="button" class="chip" aria-pressed="@(_filter.All ? "true" : "false")" @onclick="() => SetFilterAsync(DayFilter.Everything)">
            Todos <span class="chip-count">@ToVisit.Count()</span>
        </button>
        @for (var day = TripStart; day <= TripEnd; day = day.AddDays(1))
        {
            var d = day;
            var count = ToVisit.Count(p => p.Date == d);
            <button type="button" class="@(count == 0 ? "chip empty" : "chip")" aria-pressed="@(_filter == DayFilter.On(d) ? "true" : "false")"
                    @onclick="() => SetFilterAsync(DayFilter.On(d))">
                @Pt.Long(d) <span class="chip-count">@count</span>
            </button>
        }
        @{ var noDay = ToVisit.Count(p => p.Date is null); }
        @if (Places.Any(p => p.Date is null) || _filter == DayFilter.NoDay)
        {
            <button type="button" class="chip" aria-pressed="@(_filter == DayFilter.NoDay ? "true" : "false")" @onclick="() => SetFilterAsync(DayFilter.NoDay)">
                Sem dia <span class="chip-count">@noDay</span>
            </button>
        }
    </div>
}

<div class="place-map">
    <div class="map-area">
        <div class="map-canvas" @ref="_mapElement" aria-label="Mapa dos locais a visitar"></div>
        @if (_mapError is not null)
        {
            <div class="map-error" role="alert">@_mapError</div>
        }
    </div>

    <div class="place-side">
        <div class="place-search">
            <input class="input" placeholder="Procurar local (ex.: Coliseu, Roma)" aria-label="Procurar local"
                   @bind="_query" @bind:event="oninput" @onkeydown="OnSearchKeyDown" />
            <button type="button" class="btn small" disabled="@_searching" @onclick="SearchAsync">
                @(_searching ? "…" : "Procurar")
            </button>
        </div>

        @if (_searchError is not null)
        {
            <p class="small map-search-error" role="alert">@_searchError</p>
        }

        @if (_results.Count > 0)
        {
            <ul class="plain-list search-results" aria-label="Resultados da pesquisa">
                @foreach (var result in _results)
                {
                    var r = result;
                    <li>
                        <button type="button" class="search-result" @onclick="() => AddFromSearchAsync(r)">
                            <strong>@r.Name</strong>
                            <span class="muted small">@r.Description</span>
                        </button>
                    </li>
                }
            </ul>
        }

        @if (Places.Count == 0)
        {
            <p class="muted small">
                Clica no mapa ou procura um local para o marcar. Podes arrastar os marcadores para os acertar.
                Usa o botão <span class="inline-house">@HouseIcon</span> para marcar onde vais ficar.
            </p>
        }
        else
        {
            var numbers = PlanPlaceDto.Numbers(Places);
            @if (!_filter.All && !Places.Any(p => !p.IsLodging && Visible(p)))
            {
                <p class="muted small">Nenhum local @(_filter.Day is { } fd ? $"para {Pt.Long(fd)}" : "sem dia"). Clica no mapa para juntar um.</p>
            }

            <ol class="plain-list place-list">
                @for (var i = 0; i < Places.Count; i++)
                {
                    var index = i;
                    var p = Places[i];
                    if (!Visible(p))
                        continue;

                    <li class="@ItemCss(p)">
                        <button type="button" class="@(p.IsLodging ? "place-number lodging" : "place-number")" title="Ver no mapa"
                                aria-label="Ver @p.Name no mapa" @onclick="() => FocusAsync(index)">
                            @if (p.IsLodging) { @HouseIcon } else { @numbers[index] }
                        </button>
                        <div class="place-fields">
                            <input class="input" aria-label="Nome do local" maxlength="@VacationPlanValidator.ShortTextMaxLength"
                                   @bind="p.Name" @bind:after="ChangedAsync" />
                            <div class="place-row">
                                @if (p.IsLodging)
                                {
                                    @* Estadia: do primeiro ao último dia (podem ser vários alojamentos, um por cidade ou país) *@
                                    <select class="input" aria-label="Primeiro dia no alojamento" title="Primeiro dia"
                                            @bind="p.Date" @bind:format="yyyy-MM-dd" @bind:after="() => StayStartChangedAsync(p)">
                                        <option value="">Sem datas</option>
                                        @for (var day = TripStart; day <= TripEnd; day = day.AddDays(1))
                                        {
                                            <option value="@day.ToString("yyyy-MM-dd")">@Pt.Long(day)</option>
                                        }
                                    </select>
                                    @if (p.Date is { } stayStart)
                                    {
                                        <span class="small muted">até</span>
                                        <select class="input" aria-label="Último dia no alojamento" title="Último dia"
                                                @bind="p.EndDate" @bind:format="yyyy-MM-dd" @bind:after="ChangedAsync">
                                            @for (var day = stayStart; day <= TripEnd; day = day.AddDays(1))
                                            {
                                                <option value="@day.ToString("yyyy-MM-dd")">@Pt.Long(day)</option>
                                            }
                                        </select>
                                    }
                                }
                                else
                                {
                                    @* Só os dias das férias podem ser escolhidos *@
                                    <select class="input" aria-label="Dia da visita" @bind="p.Date" @bind:format="yyyy-MM-dd" @bind:after="ChangedAsync">
                                        <option value="">Sem dia</option>
                                        @for (var day = TripStart; day <= TripEnd; day = day.AddDays(1))
                                        {
                                            <option value="@day.ToString("yyyy-MM-dd")">@Pt.Long(day)</option>
                                        }
                                    </select>
                                    <label class="check small" title="Já visitei">
                                        <input type="checkbox" @bind="p.Visited" @bind:after="ChangedAsync" />
                                        <span>Visitado</span>
                                    </label>
                                }
                                <button type="button" class="btn icon ghost small lodging-toggle" aria-pressed="@(p.IsLodging ? "true" : "false")"
                                        title="@(p.IsLodging ? "Deixar de ser o alojamento" : "Marcar como alojamento (onde vamos ficar)")"
                                        aria-label="Alojamento: @p.Name" @onclick="() => ToggleLodgingAsync(p)">@HouseIcon</button>
                                <button type="button" class="btn icon ghost small" aria-label="Remover @p.Name" @onclick="() => RemoveAsync(index)">✕</button>
                            </div>
                        </div>
                    </li>
                }
            </ol>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public List<PlanPlaceDto> Places { get; set; } = [];
    [Parameter] public DateOnly TripStart { get; set; }
    [Parameter] public DateOnly TripEnd { get; set; }

    /// <summary>Destino das férias: centra o mapa quando ainda não há locais.</summary>
    [Parameter] public string? Destination { get; set; }

    /// <summary>Avisa a página de que os locais mudaram (para o aviso de "por guardar").</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>Ícone de casa do alojamento (o mesmo desenho é usado no mapa, em plan-map.js).</summary>
    private static readonly RenderFragment HouseIcon = @<svg class="house-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3.2 2.5 11h2.7v9.3h5.3v-6h3v6h5.3V11h2.7z" fill="currentColor" /></svg>;

    /// <summary>Filtro da lista e do mapa: todos, um dia das férias, ou os locais sem dia.</summary>
    private readonly record struct DayFilter(bool All, DateOnly? Day)
    {
        public static DayFilter Everything => new(true, null);
        public static DayFilter NoDay => new(false, null);
        public static DayFilter On(DateOnly day) => new(false, day);
    }

    private DayFilter _filter = DayFilter.Everything;

    private IEnumerable<PlanPlaceDto> ToVisit => Places.Where(p => !p.IsLodging);

    /// <summary>
    /// Se o local aparece com o filtro atual: num dia, os locais desse dia e o alojamento
    /// dessa noite; em "Sem dia", os locais e alojamentos sem data.
    /// </summary>
    private bool Visible(PlanPlaceDto p) => _filter switch
    {
        { All: true } => true,
        { Day: { } day } => p.IsLodging ? p.StaysOn(day) : p.Date == day,
        _ => p.Date is null,
    };

    private static string ItemCss(PlanPlaceDto p) =>
        p.IsLodging ? "place-item lodging" : p.Visited ? "place-item visited" : "place-item";

    private ElementReference _mapElement;
    private IJSObjectReference? _module;
    private IJSObjectReference? _map;
    private DotNetObjectReference<PlaceMap>? _self;
    private string? _drawnSignature;
    private string? _mapError;

    private string _query = "";
    private bool _searching;
    private string? _searchError;
    private List<SearchResult> _results = [];

    /// <summary>Resultado da pesquisa de locais (vem do JavaScript).</summary>
    public sealed class SearchResult
    {
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public double Lat { get; set; }
        public double Lng { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CreateMapAsync();
            return;
        }

        await RedrawIfChangedAsync(fit: false);
    }

    private async Task CreateMapAsync()
    {
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/plan-map.js");
            _self = DotNetObjectReference.Create(this);
            _drawnSignature = Signature();
            _map = await _module.InvokeAsync<IJSObjectReference>("create", _mapElement, _self, MarkerData());

            // Sem locais: centra no destino, se houver
            if (Places.Count == 0 && !string.IsNullOrWhiteSpace(Destination))
            {
                var found = await _module.InvokeAsync<List<SearchResult>>("search", Destination.Trim());
                if (found.Count > 0)
                    await _map.InvokeVoidAsync("centerOn", found[0].Lat, found[0].Lng, 12);
            }
        }
        catch (JSDisconnectedException)
        {
            // A página foi fechada entretanto
        }
        catch (Exception ex)
        {
            _mapError = ex is JSException ? ex.Message : $"Não foi possível mostrar o mapa. {ex.Message}";
            StateHasChanged();
        }
    }

    /// <summary>Só redesenha os marcadores quando os nomes, posições ou estado mudaram.</summary>
    private async Task RedrawIfChangedAsync(bool fit)
    {
        if (_map is null)
            return;

        var signature = Signature();
        if (signature == _drawnSignature)
            return;

        _drawnSignature = signature;
        await _map.InvokeVoidAsync("setPlaces", MarkerData(), fit);
    }

    /// <summary>Marcadores dos locais visíveis com o filtro atual (o índice é a posição na lista completa).</summary>
    private object[] MarkerData()
    {
        var numbers = PlanPlaceDto.Numbers(Places);
        return Places
            .Select((p, i) => (p, i))
            .Where(x => Visible(x.p))
            .Select(x => (object)new
            {
                index = x.i,
                number = numbers[x.i],
                name = x.p.Name,
                lat = x.p.Latitude,
                lng = x.p.Longitude,
                visited = x.p.Visited,
                lodging = x.p.IsLodging,
            })
            .ToArray();
    }

    private string Signature() => JsonSerializer.Serialize(MarkerData());

    // ---------- Chamadas vindas do mapa ----------

    [JSInvokable]
    public async Task OnMapClick(double lat, double lng)
    {
        var number = Places.Count(p => !p.IsLodging) + 1;
        Places.Add(new PlanPlaceDto { Name = $"Local {number}", Latitude = lat, Longitude = lng, Date = FilterDate });
        await ChangedAsync();
    }

    [JSInvokable]
    public async Task OnPlaceMoved(int index, double lat, double lng)
    {
        if (index < 0 || index >= Places.Count)
            return;

        Places[index].Latitude = lat;
        Places[index].Longitude = lng;
        _drawnSignature = Signature(); // o marcador já está no sítio certo
        await ChangedAsync();
    }

    // ---------- Pesquisa ----------

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchAsync();
    }

    private async Task SearchAsync()
    {
        if (_module is null || string.IsNullOrWhiteSpace(_query) || _searching)
            return;

        _searching = true;
        _searchError = null;
        try
        {
            _results = await _module.InvokeAsync<List<SearchResult>>("search", _query.Trim());
            if (_results.Count == 0)
                _searchError = "Nenhum local encontrado.";
        }
        catch (Exception ex)
        {
            _results = [];
            _searchError = $"Não foi possível procurar. {ex.Message}";
        }
        finally
        {
            _searching = false;
        }
    }

    private async Task AddFromSearchAsync(SearchResult result)
    {
        var name = result.Name.Length > VacationPlanValidator.ShortTextMaxLength
            ? result.Name[..VacationPlanValidator.ShortTextMaxLength]
            : result.Name;

        Places.Add(new PlanPlaceDto { Name = name, Latitude = result.Lat, Longitude = result.Lng, Date = FilterDate });
        _results = [];
        _query = "";
        await ChangedAsync();
        await RedrawIfChangedAsync(fit: false);
        await FocusAsync(Places.Count - 1);
    }

    // ---------- Filtro e alojamento ----------

    /// <summary>Com um dia escolhido no filtro, os locais novos ficam nesse dia.</summary>
    private DateOnly? FilterDate => _filter.All ? null : _filter.Day;

    private async Task SetFilterAsync(DayFilter filter)
    {
        _filter = filter;
        StateHasChanged();
        await RedrawIfChangedAsync(fit: true);
    }

    private async Task ToggleLodgingAsync(PlanPlaceDto place)
    {
        place.IsLodging = !place.IsLodging;
        place.Visited = false;
        if (place.IsLodging)
        {
            // Estadia por omissão: do dia do local (ou do dia filtrado) até ao fim da viagem
            place.Date ??= FilterDate ?? TripStart;
            place.EndDate = TripEnd;
        }
        else
        {
            // Volta a ser um local a visitar: fica com o primeiro dia da estadia
            place.EndDate = null;
        }

        await ChangedAsync();
    }

    /// <summary>Mudou o primeiro dia: o último nunca fica antes dele (e sem datas fica sem nenhuma).</summary>
    private async Task StayStartChangedAsync(PlanPlaceDto place)
    {
        if (place.Date is not { } start)
            place.EndDate = null;
        else if (place.EndDate is not { } end || end < start)
            place.EndDate = start;

        await ChangedAsync();
    }

    // ---------- Lista ----------

    private async Task FocusAsync(int index)
    {
        if (_map is not null)
            await _map.InvokeVoidAsync("focus", index);
    }

    private async Task RemoveAsync(int index)
    {
        Places.RemoveAt(index);
        await ChangedAsync();
    }

    private Task ChangedAsync() => OnChanged.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_map is not null)
            {
                await _map.InvokeVoidAsync("dispose");
                await _map.DisposeAsync();
            }

            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Nada a limpar: o navegador já fechou a página
        }

        _self?.Dispose();
    }
}
