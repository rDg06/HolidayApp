@* Mapa com os locais a visitar: clicar no mapa ou procurar pelo nome para marcar. *@
@using System.Text.Json
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="place-map-root" @ref="_root">
@if (Places.Count > 0)
{
    @* Filtro por dia: mostra só os locais desse dia e o alojamento dessa noite, no mapa e na lista *@
    <div class="day-filter" role="group" aria-label="Filtrar locais por dia">
        <button type="button" class="chip" aria-pressed="@(_filter.All ? "true" : "false")" @onclick="() => SetFilterAsync(DayFilter.Everything)">
            Todos <span class="chip-count">@ToVisit.Count()</span>
        </button>
        @for (var day = TripStart; day <= TripEnd; day = day.AddDays(1))
        {
            var d = day;
            var count = ToVisit.Count(p => p.Date == d);
            <button type="button" class="@ChipCss(d, count)" aria-pressed="@(_filter == DayFilter.On(d) ? "true" : "false")"
                    @onclick="() => SetFilterAsync(DayFilter.On(d))">
                @(d == Today ? $"Hoje · {Pt.Long(d)}" : Pt.Long(d)) <span class="chip-count">@count</span>
            </button>
        }
        @{ var noDay = ToVisit.Count(p => p.Date is null); }
        @if (Places.Any(p => p.Date is null) || _filter == DayFilter.NoDay)
        {
            <button type="button" class="chip" aria-pressed="@(_filter == DayFilter.NoDay ? "true" : "false")" @onclick="() => SetFilterAsync(DayFilter.NoDay)">
                Sem dia <span class="chip-count">@noDay</span>
            </button>
        }
    </div>
}

<div class="place-map">
    <div class="map-area">
        <div class="map-canvas" @ref="_mapElement" aria-label="Mapa dos locais a visitar"></div>
        @if (_mapError is not null)
        {
            <div class="map-error" role="alert">@_mapError</div>
        }
    </div>

    <div class="place-side">
        <div class="place-search">
            <input class="input" placeholder="Procurar local (ex.: Coliseu, Roma)" aria-label="Procurar local"
                   @bind="_query" @bind:event="oninput" @onkeydown="OnSearchKeyDown" />
            <button type="button" class="btn small" disabled="@_searching" @onclick="SearchAsync">
                @(_searching ? "…" : "Procurar")
            </button>
        </div>

        @if (_lodgingSearch is not null)
        {
            <p class="small lodging-search" role="status">
                <PlaceIcon /> Escolhe o resultado certo para o alojamento <strong>@_lodgingSearch.Name</strong>.
                <button type="button" class="btn ghost small" @onclick="CancelLodgingSearch">Cancelar</button>
            </p>
        }

        @if (_searchError is not null)
        {
            <p class="small map-search-error" role="alert">@_searchError</p>
        }

        @if (_results.Count > 0)
        {
            <ul class="plain-list search-results" aria-label="Resultados da pesquisa">
                @foreach (var result in _results)
                {
                    var r = result;
                    <li>
                        <button type="button" class="search-result" @onclick="() => AddFromSearchAsync(r)">
                            <strong>@r.Name</strong>
                            <span class="muted small">@r.Description</span>
                        </button>
                    </li>
                }
            </ul>
        }

        @if (Places.Count == 0)
        {
            <p class="muted small">
                Clica no mapa ou procura um local para o marcar. Podes arrastar os marcadores para os acertar.
                No botão do tipo (<span class="inline-icon"><PlaceIcon Kind="PlaceKind.Visita" /> ▾</span>) marcas o alojamento, aeroportos e estações de metro, autocarro ou comboio.
            </p>
        }
        else
        {
            var numbers = PlanPlaceDto.Numbers(Places);
            var route = Route;
            var routed = RoutedFor(route);
            var legs = route.Skip(1).Select((s, i) => (s.Place, Text: LegText(route, routed, i))).ToList();
            @if (!_filter.All && !Places.Any(p => !p.IsLodging && Visible(p) && !IsReference(p)))
            {
                <p class="muted small">Nenhum local @(_filter.Day is { } fd ? $"para {Pt.Long(fd)}" : "sem dia"). Clica no mapa para juntar um.</p>
            }

            @if (route.Count > 1)
            {
                <div class="route-total small">
                    <p>
                        Percurso do dia:
                        @if (routed is not null)
                        {
                            <strong>@Pt.Km(routed.Distance / 1000) · @Pt.Duration(routed.Duration) @Pt.Label(RouteMode)</strong>
                        }
                        else
                        {
                            <strong>@Pt.Km(PlaceRoute.TotalKm(route))</strong>
                            <span class="muted">
                                em linha reta@(_routeState switch
                                {
                                    RouteState.Loading => " · a calcular o caminho…",
                                    RouteState.Failed => " · sem caminho por ruas (sem internet ou sem caminho possível)",
                                    _ => "",
                                })
                            </span>
                        }
                        <span class="muted"> · arrasta os locais para mudar a ordem</span>
                    </p>
                    <div class="route-modes" role="group" aria-label="Como te deslocas">
                        @foreach (var mode in Enum.GetValues<RouteMode>())
                        {
                            var m = mode;
                            <button type="button" class="chip" aria-pressed="@(RouteMode == m ? "true" : "false")"
                                    @onclick="() => SetRouteModeAsync(m)">@ModeName(m)</button>
                        }
                    </div>
                </div>
            }

            <ol class="plain-list place-list">
                @for (var i = 0; i < Places.Count; i++)
                {
                    var index = i;
                    var p = Places[i];
                    if (!Visible(p))
                        continue;

                    // Distância desde a paragem anterior (o alojamento de chegada aparece no fim do percurso)
                    var leg = legs.FirstOrDefault(l => ReferenceEquals(l.Place, p));

                    <PlaceItem @key="p"
                               Place="p"
                               Number="numbers[index]"
                               Index="index"
                               TripStart="TripStart"
                               TripEnd="TripEnd"
                               FilterDay="FilterDate"
                               Leg="@leg.Text"
                               OnFocus="() => FocusAsync(index)"
                               KindMenuOpen="ReferenceEquals(_kindMenuFor, p)"
                               OnToggleKindMenu="() => ToggleKindMenu(p)"
                               OnRemove="() => RemoveAsync(index)"
                               OnChanged="ChangedAsync" />
                }
            </ol>
        }
    </div>
</div>
</div>

@code {
    [Parameter, EditorRequired] public List<PlanPlaceDto> Places { get; set; } = [];
    [Parameter] public DateOnly TripStart { get; set; }
    [Parameter] public DateOnly TripEnd { get; set; }

    /// <summary>Destino das férias: centra o mapa quando ainda não há locais e ajuda a procurar alojamentos.</summary>
    [Parameter] public string? Destination { get; set; }

    /// <summary>Dia de hoje (pode ser trocado nos testes). Durante a viagem, o mapa abre neste dia.</summary>
    [Parameter] public DateOnly Today { get; set; } = DateOnly.FromDateTime(DateTime.Today);

    /// <summary>Avisa a página de que os locais mudaram (para o aviso de "por guardar").</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>Como se anda entre os locais (caminho e tempos). Guardado na viagem.</summary>
    [Parameter] public RouteMode RouteMode { get; set; }
    [Parameter] public EventCallback<RouteMode> RouteModeChanged { get; set; }

    /// <summary>Filtro da lista e do mapa: todos, um dia das férias, ou os locais sem dia.</summary>
    private readonly record struct DayFilter(bool All, DateOnly? Day)
    {
        public static DayFilter Everything => new(true, null);
        public static DayFilter NoDay => new(false, null);
        public static DayFilter On(DateOnly day) => new(false, day);
    }

    private DayFilter _filter = DayFilter.Everything;

    /// <summary>Local com o menu do tipo aberto (só um de cada vez).</summary>
    private PlanPlaceDto? _kindMenuFor;

    private void ToggleKindMenu(PlanPlaceDto place) =>
        _kindMenuFor = ReferenceEquals(_kindMenuFor, place) ? null : place;

    /// <summary>Locais a visitar (os que contam nos números dos filtros).</summary>
    private IEnumerable<PlanPlaceDto> ToVisit => Places.Where(p => p.IsVisit);

    /// <summary>
    /// Se o local aparece com o filtro atual: num dia, os locais e transportes desse dia, o
    /// alojamento dessa noite e os transportes sem dia (servem todos os dias); em "Sem dia",
    /// tudo o que não tem data.
    /// </summary>
    private bool Visible(PlanPlaceDto p) => _filter switch
    {
        { All: true } => true,
        { Day: { } day } => p.IsLodging ? p.StaysOn(day) : p.Date == day || (p.IsTransport && p.Date is null),
        _ => p.Date is null,
    };

    /// <summary>Num dia: transporte sem dia, mostrado só como referência (fora do percurso e do zoom).</summary>
    private bool IsReference(PlanPlaceDto p) => _filter.Day is not null && p.IsTransport && p.Date is null;

    /// <summary>Posições (na lista completa) dos locais que se podem arrastar e estão à vista, pela ordem.</summary>
    private List<int> VisibleVisits =>
        Places.Select((p, i) => (p, i)).Where(x => !x.p.IsLodging && Visible(x.p)).Select(x => x.i).ToList();

    /// <summary>Percurso do dia filtrado (vazio em "Todos" e "Sem dia").</summary>
    private List<RouteStop> Route => _filter.Day is { } day ? PlaceRoute.ForDay(Places, day) : [];

    private string ChipCss(DateOnly day, int count) =>
        "chip" + (count == 0 ? " empty" : "") + (day == Today ? " today" : "");

    private ElementReference _root;
    private ElementReference _mapElement;
    private IJSObjectReference? _module;
    private IJSObjectReference? _map;
    private DotNetObjectReference<PlaceMap>? _self;
    private string? _drawnSignature;
    private string? _mapError;

    private string _query = "";
    private bool _searching;
    private string? _searchError;
    private List<SearchResult> _results = [];

    /// <summary>Reserva de alojamento à espera que se escolha o resultado certo da pesquisa.</summary>
    private sealed record LodgingSearch(string Name, DateOnly? From);
    private LodgingSearch? _lodgingSearch;

    /// <summary>Resultado da pesquisa de locais (vem do JavaScript).</summary>
    public sealed class SearchResult
    {
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public double Lat { get; set; }
        public double Lng { get; set; }
    }

    protected override void OnInitialized()
    {
        // Em viagem: abre no dia de hoje
        if (Today >= TripStart && Today <= TripEnd)
            _filter = DayFilter.On(Today);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CreateMapAsync();
            await UpdateRouteAsync(); // em viagem abre já num dia
            return;
        }

        await RedrawIfChangedAsync(fit: false);
        await UpdateRouteAsync();
    }

    private async Task CreateMapAsync()
    {
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/plan-map.js");
            _self = DotNetObjectReference.Create(this);
            _drawnSignature = Signature();
            _map = await _module.InvokeAsync<IJSObjectReference>("create", _mapElement, _self, MarkerData(), RouteData());
            await _module.InvokeVoidAsync("attachSortable", _root, _self);

            // "Pôr no mapa" pedido antes de o mapa estar pronto: procura agora
            if (_lodgingSearch is not null && _results.Count == 0)
            {
                await SearchAsync();
                StateHasChanged();
            }

            // Sem locais: centra no destino, se houver
            if (_map is not null && Places.Count == 0 && !string.IsNullOrWhiteSpace(Destination))
            {
                var found = await _module.InvokeAsync<List<SearchResult>>("search", Destination.Trim());
                if (found is { Count: > 0 })
                    await _map.InvokeVoidAsync("centerOn", found[0].Lat, found[0].Lng, 12);
            }
        }
        catch (JSDisconnectedException)
        {
            // A página foi fechada entretanto
        }
        catch (Exception ex)
        {
            _mapError = ex is JSException ? ex.Message : $"Não foi possível mostrar o mapa. {ex.Message}";
            StateHasChanged();
        }
    }

    /// <summary>Só redesenha os marcadores quando os nomes, posições, estado ou percurso mudaram.</summary>
    private async Task RedrawIfChangedAsync(bool fit)
    {
        if (_map is null)
            return;

        var signature = Signature();
        if (signature == _drawnSignature)
            return;

        _drawnSignature = signature;
        await _map.InvokeVoidAsync("setPlaces", MarkerData(), fit, RouteData());
    }

    /// <summary>Marcadores dos locais visíveis com o filtro atual (o índice é a posição na lista completa).</summary>
    private object[] MarkerData() => MapMarkers.Build(Places, Visible, IsReference);

    /// <summary>Pontos da linha do percurso do dia ([lat, lng], pela ordem).</summary>
    private object RouteData()
    {
        var route = Route;
        return RoutedFor(route) is { } routed
            ? new { points = routed.Geometry, exact = true }
            : new { points = route.Select(s => new[] { s.Place.Latitude, s.Place.Longitude }).ToArray(), exact = false };
    }

    // ---------- Caminho por ruas (serviço de rotas do OpenStreetMap) ----------

    private enum RouteState { None, Loading, Done, Failed }

    private string? _routeKey;
    private RouteResult? _routeResult;
    private RouteState _routeState;

    /// <summary>O caminho calculado, se for deste percurso e deste modo (senão, linha reta).</summary>
    private RouteResult? RoutedFor(List<RouteStop> route) =>
        route.Count > 1 && _routeState == RouteState.Done && _routeKey == Routing.Key(route.Select(s => s.Place), RouteMode)
            ? _routeResult
            : null;

    private string LegText(List<RouteStop> route, RouteResult? routed, int index)
    {
        var previous = route[index].Place.Name;
        if (routed is not null)
        {
            var leg = routed.Legs[index];
            return $"{Pt.Km(leg.Distance / 1000)} · {Pt.Duration(leg.Duration)} desde {previous}";
        }

        return $"{Pt.Km(route[index + 1].KmFromPrevious ?? 0)} em linha reta desde {previous}";
    }

    private static string ModeName(RouteMode mode) => mode switch
    {
        RouteMode.Carro => "Carro",
        RouteMode.Bicicleta => "Bicicleta",
        _ => "A pé",
    };

    private async Task SetRouteModeAsync(RouteMode mode)
    {
        if (mode == RouteMode)
            return;

        RouteMode = mode;
        await RouteModeChanged.InvokeAsync(mode);
        await ChangedAsync();
    }

    /// <summary>Pede o caminho quando o percurso do dia (ou o modo) muda. Corre depois de cada desenho.</summary>
    private async Task UpdateRouteAsync()
    {
        var route = Route;
        if (_module is null || route.Count < 2)
        {
            _routeKey = null;
            _routeState = RouteState.None;
            return;
        }

        var key = Routing.Key(route.Select(s => s.Place), RouteMode);
        if (key == _routeKey)
            return;

        _routeKey = key;
        _routeResult = null;
        _routeState = RouteState.Loading;
        StateHasChanged();

        RouteResult? result = null;
        var state = RouteState.Failed;
        try
        {
            result = await Routing.GetAsync(_module, route.Select(s => s.Place).ToList(), RouteMode);
            state = result is null ? RouteState.Failed : RouteState.Done;
        }
        catch (Exception)
        {
            // Sem internet ou serviço em baixo: fica a linha reta
        }

        if (_routeKey != key)
            return; // entretanto mudou o dia, a ordem ou o modo

        _routeResult = result;
        _routeState = state;
        StateHasChanged();
    }

    private string Signature() => JsonSerializer.Serialize(new { m = MarkerData(), r = RouteData() });

    // ---------- Chamadas vindas do mapa ----------

    [JSInvokable]
    public async Task OnMapClick(double lat, double lng)
    {
        var number = Places.Count(p => p.IsVisit) + 1;
        Places.Add(new PlanPlaceDto { Name = $"Local {number}", Latitude = lat, Longitude = lng, Date = FilterDate });
        await ChangedAsync();
    }

    [JSInvokable]
    public async Task OnPlaceMoved(int index, double lat, double lng)
    {
        if (index < 0 || index >= Places.Count)
            return;

        Places[index].Latitude = lat;
        Places[index].Longitude = lng;
        await ChangedAsync();
        await RedrawIfChangedAsync(fit: false); // o percurso do dia muda com o marcador
    }

    // ---------- Pesquisa ----------

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchAsync();
    }

    private async Task SearchAsync()
    {
        if (_module is null || string.IsNullOrWhiteSpace(_query) || _searching)
            return;

        _searching = true;
        _searchError = null;
        try
        {
            _results = await _module.InvokeAsync<List<SearchResult>>("search", _query.Trim()) ?? [];

            // Alojamento com o destino não encontrado: tenta só pelo nome
            if (_results.Count == 0 && _lodgingSearch is not null && _query.Trim() != _lodgingSearch.Name)
            {
                _query = _lodgingSearch.Name;
                _results = await _module.InvokeAsync<List<SearchResult>>("search", _query) ?? [];
            }

            if (_results.Count == 0)
                _searchError = _lodgingSearch is null
                    ? "Nenhum local encontrado."
                    : "Não encontrei o alojamento. Muda o texto da pesquisa ou clica no mapa e usa o botão da casa.";
        }
        catch (Exception ex)
        {
            _results = [];
            _searchError = $"Não foi possível procurar. {ex.Message}";
        }
        finally
        {
            _searching = false;
        }
    }

    private async Task AddFromSearchAsync(SearchResult result)
    {
        var lodging = _lodgingSearch;
        var name = lodging?.Name ?? result.Name;
        if (name.Length > VacationPlanValidator.ShortTextMaxLength)
            name = name[..VacationPlanValidator.ShortTextMaxLength];

        var place = new PlanPlaceDto { Name = name, Latitude = result.Lat, Longitude = result.Lng, Date = FilterDate };
        if (lodging is not null)
        {
            // Da reserva: entra no dia da reserva e fica até ao fim da viagem
            place.IsLodging = true;
            place.Date = lodging.From ?? TripStart;
            place.EndDate = TripEnd;
            if (!Visible(place))
                _filter = DayFilter.Everything;
        }

        Places.Add(place);
        _results = [];
        _query = "";
        _lodgingSearch = null;
        await ChangedAsync();
        await RedrawIfChangedAsync(fit: false);
        await FocusAsync(Places.Count - 1);
    }

    /// <summary>
    /// Põe uma reserva de alojamento no mapa: procura pelo nome (e destino) e deixa escolher o
    /// resultado certo. Chamado pela página a partir da lista de reservas.
    /// </summary>
    public async Task FindLodgingAsync(string name, DateOnly? from)
    {
        _lodgingSearch = new LodgingSearch(name.Trim(), from);
        _query = string.IsNullOrWhiteSpace(Destination) ? name.Trim() : $"{name.Trim()}, {Destination.Trim()}";
        _results = [];
        StateHasChanged();

        try
        {
            if (_module is not null)
                await _module.InvokeVoidAsync("scrollIntoView", _root);
        }
        catch (JSException)
        {
            // Sem deslocação: a pesquisa continua
        }

        await SearchAsync();
        StateHasChanged();
    }

    private void CancelLodgingSearch()
    {
        _lodgingSearch = null;
        _results = [];
        _searchError = null;
        _query = "";
    }

    // ---------- Filtro ----------

    /// <summary>Com um dia escolhido no filtro, os locais novos ficam nesse dia.</summary>
    private DateOnly? FilterDate => _filter.All ? null : _filter.Day;

    private async Task SetFilterAsync(DayFilter filter)
    {
        _filter = filter;
        StateHasChanged();
        await RedrawIfChangedAsync(fit: true);
    }

    // ---------- Lista ----------

    private async Task FocusAsync(int index)
    {
        if (_map is not null)
            await _map.InvokeVoidAsync("focus", index);
    }

    // ---------- Arrastar para mudar a ordem (vem de plan-map.js) ----------

    /// <summary>
    /// Largou o local <paramref name="from"/> antes (ou depois) do local <paramref name="target"/>.
    /// Os índices são posições na lista completa; muda a ordem do percurso e os números.
    /// </summary>
    [JSInvokable]
    public async Task OnReorder(int from, int target, bool after)
    {
        if (from == target || from < 0 || target < 0 || from >= Places.Count || target >= Places.Count)
            return;

        var place = Places[from];
        var anchor = Places[target];
        Places.RemoveAt(from);
        var at = Places.IndexOf(anchor);
        Places.Insert(after ? at + 1 : at, place);

        await ChangedAsync();
        StateHasChanged();
    }

    /// <summary>
    /// Teclado (setas na pega): troca com o anterior/seguinte dos locais à vista.
    /// Devolve a nova posição, para a pega continuar com o foco.
    /// </summary>
    [JSInvokable]
    public async Task<int> OnReorderStep(int index, int direction)
    {
        var order = VisibleVisits;
        var position = order.IndexOf(index);
        var target = position + Math.Sign(direction);
        if (position < 0 || target < 0 || target >= order.Count)
            return index;

        var other = order[target];
        (Places[index], Places[other]) = (Places[other], Places[index]);
        await ChangedAsync();
        StateHasChanged();
        return other;
    }

    private async Task RemoveAsync(int index)
    {
        Places.RemoveAt(index);
        await ChangedAsync();
    }

    private Task ChangedAsync() => OnChanged.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_map is not null)
            {
                await _map.InvokeVoidAsync("dispose");
                await _map.DisposeAsync();
            }

            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Nada a limpar: o navegador já fechou a página
        }

        _self?.Dispose();
    }
}
