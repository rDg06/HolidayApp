@* The year's holidays (past ones are faded). *@

<details class="card">
    <summary><h3>Holidays in @Year</h3></summary>
    <ul class="plain-list holidays">
        @foreach (var holiday in Holidays)
        {
            <li class="@(holiday.Date < Today ? "past" : null)">
                <span class="holiday-date">@Display.Long(holiday.Date)</span>
                <span>@holiday.Name</span>
            </li>
        }
    </ul>
</details>

@code {
    [Parameter] public int Year { get; set; }
    [Parameter] public IReadOnlyList<HolidayDto> Holidays { get; set; } = [];
    [Parameter] public DateOnly Today { get; set; }
}
