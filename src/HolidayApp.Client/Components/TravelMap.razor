@* "Where I've been" (Map page): map with every trip (past and upcoming), countries and numbers. *@
@using System.Text.Json
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IAsyncDisposable

<section class="card travel-map" aria-labelledby="travel-map-title">
    <div class="section-head">
        <h2 id="travel-map-title" class="visually-hidden">Trips map</h2>
        <div class="travel-legend small">
            <span><span class="legend-dot trip-past"></span>Past</span>
            <span><span class="legend-dot trip-next"></span>Upcoming</span>
            @if (VisitedPlaces.Count > 0)
            {
                <span><span class="legend-dot trip-manual"></span>Other places</span>
            }
        </div>
    </div>

    <dl class="travel-stats">
        <div><dt>Trips taken</dt><dd>@PastTrips.Count</dd></div>
        <div><dt>Days travelling</dt><dd>@PastTrips.Sum(DaysOf)</dd></div>
        <div>
            <dt>Countries</dt>
            <dd>@(_locating && Countries.Count == 0 ? "…" : Countries.Count.ToString())</dd>
        </div>
        <div><dt>Upcoming</dt><dd>@(Vacations.Count - PastTrips.Count)</dd></div>
    </dl>

    @if (Countries.Count > 0)
    {
        <ul class="plain-list travel-countries" aria-label="Countries visited">
            @foreach (var country in Countries)
            {
                <li class="tag">@country</li>
            }
        </ul>
    }

    <div class="travel-canvas" @ref="_mapElement" aria-label="Trips map"></div>

    @{ var unplaced = Vacations.Count(v => !_points.ContainsKey(v.Id)); }
    @if (!_locating && unplaced > 0)
    {
        <p class="muted small travel-note">
            @(unplaced == 1 ? "1 trip is not on the map yet" : $"{unplaced} trips are not on the map yet"):
            add the destination or places in "Plan".
        </p>
    }
</section>

@code {
    private const string CacheKey = "holidayapp.geo.v2"; // v2: country names in English

    [Parameter, EditorRequired] public IReadOnlyList<VacationSummaryDto> Vacations { get; set; } = [];

    /// <summary>Places added by hand (they count for the countries and show on the map).</summary>
    [Parameter] public IReadOnlyList<VisitedPlaceDto> VisitedPlaces { get; set; } = [];

    /// <summary>Today (can be swapped in tests): separates past trips from upcoming ones.</summary>
    [Parameter] public DateOnly Today { get; set; } = DateOnly.FromDateTime(DateTime.Today);

    /// <summary>A point of the trip on the map and its country (when known).</summary>
    private sealed record TripPoint(string Name, double Lat, double Lng, string? Country);

    /// <summary>Place already looked up: stored in the browser so it is not asked again.</summary>
    public sealed class GeoEntry
    {
        public double? Lat { get; set; }
        public double? Lng { get; set; }
        public string? Country { get; set; }
    }

    /// <summary>Result of a destination search (comes from plan-map.js).</summary>
    public sealed class SearchResult
    {
        public double Lat { get; set; }
        public double Lng { get; set; }
        public string? Country { get; set; }
    }

    private readonly Dictionary<Guid, List<TripPoint>> _points = [];
    private Dictionary<string, GeoEntry> _cache = [];
    private bool _locating = true;

    private ElementReference _mapElement;
    private IJSObjectReference? _module;
    private IJSObjectReference? _map;
    private DotNetObjectReference<TravelMap>? _self;

    private List<VacationSummaryDto> PastTrips => Vacations.Where(v => v.EndDate < Today).ToList();

    private static int DaysOf(VacationSummaryDto v) => v.EndDate.DayNumber - v.StartDate.DayNumber + 1;

    /// <summary>Countries of past trips and of the places added by hand (in alphabetical order).</summary>
    private List<string> Countries => PastTrips
        .SelectMany(v => _points.GetValueOrDefault(v.Id) ?? [])
        .Select(p => p.Country)
        .Concat(VisitedPlaces.Select(p => p.Country))
        .OfType<string>()
        .Distinct()
        .Order(StringComparer.Create(new System.Globalization.CultureInfo("en-GB"), ignoreCase: true))
        .ToList();

    private string? _drawnVisited;

    /// <summary>Places added or deleted: redraws the points.</summary>
    protected override async Task OnParametersSetAsync()
    {
        var signature = string.Join(";", VisitedPlaces.Select(p => p.Id));
        if (_map is not null && signature != _drawnVisited)
        {
            _drawnVisited = signature;
            await RedrawAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/plan-map.js");
            _self = DotNetObjectReference.Create(this);
            _cache = await ReadCacheAsync();

            // First what is already known (plan points and destinations looked up before)
            foreach (var v in Vacations)
                AddKnownPoints(v);

            _drawnVisited = string.Join(";", VisitedPlaces.Select(p => p.Id));
            _map = await _module.InvokeAsync<IJSObjectReference>("create", _mapElement, _self, MarkerData(), null,
                new { readOnly = true, fitMaxZoom = 6 });
            StateHasChanged();

            // Then what is still to ask OpenStreetMap (destinations without places, and countries)
            await LocateMissingAsync();
        }
        catch (JSDisconnectedException)
        {
            return;
        }
        catch (Exception)
        {
            // No map (e.g. no internet): the numbers stay
        }

        _locating = false;
        StateHasChanged();
    }

    /// <summary>Points that need no lookups: the plan's, or the destination already looked up.</summary>
    private void AddKnownPoints(VacationSummaryDto v)
    {
        if (v.Points is { Count: > 0 } points)
        {
            _points[v.Id] = points
                .Select(p => new TripPoint(p.Name, p.Latitude, p.Longitude, _cache.GetValueOrDefault(CoordinateKey(p.Latitude, p.Longitude))?.Country))
                .ToList();
        }
        else if (DestinationKey(v) is { } key && _cache.GetValueOrDefault(key) is { Lat: { } lat, Lng: { } lng } found)
        {
            _points[v.Id] = [new TripPoint(v.Destination!, lat, lng, found.Country)];
        }
    }

    /// <summary>
    /// Asks Nominatim what is missing: where the destination is (trips without places) and the
    /// country of each point. One request per second, as OpenStreetMap asks; the answers are stored.
    /// </summary>
    private async Task LocateMissingAsync()
    {
        if (_module is null)
            return;

        var asked = false;
        async Task PoliteDelayAsync()
        {
            if (asked)
                await Task.Delay(1100);
            asked = true;
        }

        foreach (var v in Vacations)
        {
            if (!_points.ContainsKey(v.Id) && DestinationKey(v) is { } key && !_cache.ContainsKey(key))
            {
                await PoliteDelayAsync();
                var found = (await _module.InvokeAsync<List<SearchResult>?>("search", v.Destination!.Trim()))?.FirstOrDefault();
                _cache[key] = found is null ? new GeoEntry() : new GeoEntry { Lat = found.Lat, Lng = found.Lng, Country = found.Country };
                AddKnownPoints(v);
                await RedrawAsync();
            }

            if (_points.GetValueOrDefault(v.Id) is not { } points)
                continue;

            for (var i = 0; i < points.Count; i++)
            {
                var point = points[i];
                var coordinateKey = CoordinateKey(point.Lat, point.Lng);
                if (point.Country is not null)
                    continue;
                if (_cache.GetValueOrDefault(coordinateKey) is { } cached)
                {
                    points[i] = point with { Country = cached.Country };
                    continue;
                }

                await PoliteDelayAsync();
                var country = await _module.InvokeAsync<string?>("country", point.Lat, point.Lng);
                _cache[coordinateKey] = new GeoEntry { Country = country };
                points[i] = point with { Country = country };
                StateHasChanged();
            }
        }

        await SaveCacheAsync();
    }

    private static string? DestinationKey(VacationSummaryDto v) =>
        string.IsNullOrWhiteSpace(v.Destination) ? null : "q:" + v.Destination.Trim().ToLowerInvariant();

    /// <summary>Rounded coordinates (~1 km): points in the same city share the answer.</summary>
    private static string CoordinateKey(double lat, double lng) =>
        FormattableString.Invariant($"c:{lat:0.00},{lng:0.00}");

    /// <summary>
    /// One marker per trip point (the index is the trip's position in the list, to open it)
    /// and one per place added by hand (indices after the trips; they only show the name).
    /// </summary>
    private object[] MarkerData() => TripMarkers().Concat(VisitedMarkers()).ToArray();

    private IEnumerable<object> VisitedMarkers() => VisitedPlaces.Select((p, i) => (object)new
    {
        index = Vacations.Count + i,
        number = (int?)null,
        name = $"{p.Name} · {p.Year}",
        lat = p.Latitude,
        lng = p.Longitude,
        visited = false,
        kind = "trip-manual",
        icon = PlaceIcons.Svg(PlaceKind.Visit),
        label = p.Name,
        front = false,
        reference = false,
    });

    private IEnumerable<object> TripMarkers() => Vacations
        .Select((v, index) => (v, index))
        .SelectMany(x => (_points.GetValueOrDefault(x.v.Id) ?? []).Select(p => (object)new
        {
            index = x.index,
            number = (int?)null,
            name = $"{x.v.Title} · {Display.Range(x.v.StartDate, x.v.EndDate)}",
            lat = p.Lat,
            lng = p.Lng,
            visited = false,
            kind = x.v.EndDate < Today ? "trip-past" : "trip-next",
            icon = PlaceIcons.Svg(PlaceKind.Visit),
            label = p.Name,
            front = x.v.EndDate >= Today,
            reference = false,
        }));

    private async Task RedrawAsync()
    {
        if (_map is not null)
            await _map.InvokeVoidAsync("setPlaces", MarkerData(), true, null);
        StateHasChanged();
    }

    /// <summary>Clicking a point opens that trip.</summary>
    [JSInvokable]
    public void OnPlaceClick(int index)
    {
        if (index >= 0 && index < Vacations.Count)
            Navigation.NavigateTo($"vacations/{Vacations[index].Id}?from=map");
    }

    private async Task<Dictionary<string, GeoEntry>> ReadCacheAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", CacheKey);
            return string.IsNullOrEmpty(json)
                ? []
                : JsonSerializer.Deserialize<Dictionary<string, GeoEntry>>(json) ?? [];
        }
        catch (Exception)
        {
            return []; // no localStorage or broken content: ask again
        }
    }

    private async Task SaveCacheAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", CacheKey, JsonSerializer.Serialize(_cache));
        }
        catch (Exception)
        {
            // No localStorage: ask again on the next visit
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_map is not null)
            {
                await _map.InvokeVoidAsync("dispose");
                await _map.DisposeAsync();
            }

            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }

        _self?.Dispose();
    }
}
