@* The trip's bookings: type, name, day, reference, cost, link and notes. *@

<PlanSection Id="bookings" Title="Bookings" Wide="true">
    <Info>
        @if (Bookings.Count > 0)
        {
            <span class="muted small">@(Bookings.Count == 1 ? "1 booking" : $"{Bookings.Count} bookings")</span>
        }
    </Info>
    <Actions>
        <button type="button" class="btn small" @onclick="AddAsync">+ Booking</button>
    </Actions>
    <ChildContent>

    @if (Bookings.Count == 0)
    {
        <p class="muted small">Flights, lodging, car hire, tickets… Keep the references and links here.</p>
    }
    else
    {
        <div class="booking-list">
            @foreach (var booking in Bookings)
            {
                var b = booking;
                <div class="booking-row">
                    <select class="input" aria-label="Type" @bind="b.Type" @bind:after="ChangedAsync">
                        @foreach (var type in Enum.GetValues<BookingType>())
                        {
                            <option value="@type">@Display.Label(type)</option>
                        }
                    </select>
                    <input class="input" placeholder="Name (e.g. Blue Sea Hotel)" aria-label="Name"
                           maxlength="@VacationPlanValidator.ShortTextMaxLength" @bind="b.Name" @bind:after="ChangedAsync" />
                    @* Only vacation days can be chosen *@
                    <input class="@(IsOutsideTrip(b.Date) ? "input out-of-range" : "input")" type="date" aria-label="Day"
                           min="@TripStart.ToString("yyyy-MM-dd")" max="@TripEnd.ToString("yyyy-MM-dd")"
                           title="@(IsOutsideTrip(b.Date) ? "Choose a day of the vacation" : "Booking day: shows in the day-by-day plan")"
                           @bind="b.Date" @bind:format="yyyy-MM-dd" @bind:after="ChangedAsync" />
                    <input class="input" placeholder="Reference" aria-label="Booking reference"
                           maxlength="@VacationPlanValidator.ReferenceMaxLength" @bind="b.Reference" @bind:after="ChangedAsync" />
                    <span class="money-field">
                        <input class="input amount" type="number" min="0" step="0.01" placeholder="Cost" aria-label="Cost (€)"
                               title="Cost (€) — counted in the budget" @bind="b.Cost" @bind:after="ChangedAsync" />
                    </span>
                    <div class="link-field">
                        <input class="input" type="url" placeholder="https://…" aria-label="Link"
                               maxlength="@VacationPlanValidator.UrlMaxLength" @bind="b.Url" @bind:after="ChangedAsync" />
                        @if (VacationPlanValidator.IsSafeUrl(b.Url))
                        {
                            <a class="btn small" href="@b.Url!.Trim()" target="_blank" rel="noopener noreferrer">Open</a>
                        }
                    </div>
                    <div class="notes-field">
                        <input class="input booking-notes" placeholder="Notes" aria-label="Notes"
                               maxlength="@VacationPlanValidator.NotesMaxLength" @bind="b.Notes" @bind:after="ChangedAsync" />
                        @if (CanPutOnMap(b))
                        {
                            <button type="button" class="btn small put-on-map" title="Find the lodging and pin it on the map"
                                    @onclick="() => OnPutOnMap.InvokeAsync(b)"><PlaceIcon /> Put on map</button>
                        }
                    </div>
                    <button type="button" class="btn icon ghost" aria-label="Remove booking" @onclick="() => RemoveAsync(b)">✕</button>
                </div>
            }
        </div>
    }
    </ChildContent>
</PlanSection>

@code {
    [Parameter, EditorRequired] public List<PlanBookingDto> Bookings { get; set; } = [];
    [Parameter] public DateOnly TripStart { get; set; }
    [Parameter] public DateOnly TripEnd { get; set; }

    /// <summary>Tells the page something changed ("unsaved" notice, budget and plan).</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>Map places: to know whether the booking's lodging is already there.</summary>
    [Parameter] public List<PlanPlaceDto> Places { get; set; } = [];

    /// <summary>"Put on map" on a lodging booking.</summary>
    [Parameter] public EventCallback<PlanBookingDto> OnPutOnMap { get; set; }

    /// <summary>Lodging booking with a name that is not on the map as lodging yet.</summary>
    private bool CanPutOnMap(PlanBookingDto b) =>
        OnPutOnMap.HasDelegate
        && b.Type == BookingType.Lodging
        && !string.IsNullOrWhiteSpace(b.Name)
        && !Places.Any(p => p.IsLodging && string.Equals(p.Name.Trim(), b.Name.Trim(), StringComparison.OrdinalIgnoreCase));

    private bool IsOutsideTrip(DateOnly? date) => date is { } d && (d < TripStart || d > TripEnd);

    private Task AddAsync()
    {
        Bookings.Add(new PlanBookingDto { Date = TripStart });
        return ChangedAsync();
    }

    private Task RemoveAsync(PlanBookingDto booking)
    {
        Bookings.Remove(booking);
        return ChangedAsync();
    }

    private Task ChangedAsync() => OnChanged.InvokeAsync();
}
