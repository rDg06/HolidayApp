@* The year's vacation balance and the calendar colour legend. *@

<div class="card summary">
    <span class="label">Vacation days left</span>
    <div class="summary-figure">
        <span class="@(Remaining < 0 ? "big negative" : "big")">@Remaining</span>
        <span class="muted">of @AnnualDays working days</span>
    </div>
    <div class="progress" role="progressbar" aria-label="Vacation days used"
         aria-valuemin="0" aria-valuemax="@AnnualDays" aria-valuenow="@UsedDays">
        <div class="progress-bar" style="width: @(ProgressPercent)%"></div>
    </div>
    <p class="muted small">@Display.Workdays(UsedDays) booked in @Year</p>
</div>

<div class="card legend">
    <span class="legend-item"><span class="swatch ev-vacation"></span>Vacation</span>
    <span class="legend-item"><span class="swatch ev-personal"></span>Personal</span>
    <span class="legend-item"><span class="swatch ev-other"></span>Other</span>
    <span class="legend-item"><span class="swatch holiday"></span>Holiday</span>
    <span class="legend-item"><span class="swatch today"></span>Today</span>
</div>

@code {
    [Parameter] public int Year { get; set; }
    [Parameter] public YearSummaryDto? Summary { get; set; }

    private int AnnualDays => Summary?.AnnualVacationDays ?? 0;
    private int UsedDays => Summary?.UsedVacationDays ?? 0;
    private int Remaining => Summary?.RemainingVacationDays ?? 0;

    private int ProgressPercent =>
        AnnualDays <= 0 ? 0 : Math.Clamp((int)Math.Round(UsedDays * 100.0 / AnnualDays), 0, 100);
}
