@* Card of one part of the planner: title, info next to it (e.g. "3 bookings") and buttons. *@

<section class="@Css" aria-labelledby="@($"{Id}-title")">
    <div class="section-head">
        <h2 id="@($"{Id}-title")">@Title</h2>
        <div class="section-extra">
            @Info
            @Actions
        </div>
    </div>

    @ChildContent
</section>

@code {
    /// <summary>Section identifier (unique on the page).</summary>
    [Parameter, EditorRequired] public string Id { get; set; } = "";

    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>Takes the full width of the grid.</summary>
    [Parameter] public bool Wide { get; set; }

    /// <summary>Extra classes for the section.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Info next to the title (e.g. "3 bookings", "1 of 4 done").</summary>
    [Parameter] public RenderFragment? Info { get; set; }

    /// <summary>Header buttons (e.g. "+ Booking").</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string Css => "card plan-section" + (Wide ? " plan-wide" : "") + (Class is null ? "" : " " + Class);
}
