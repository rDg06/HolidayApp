@* Cartão de uma parte do planeador: título, informação ao lado (ex.: "3 reservas") e botões. *@

<section class="@Css" aria-labelledby="@($"{Id}-title")">
    <div class="section-head">
        <h2 id="@($"{Id}-title")">@Title</h2>
        <div class="section-extra">
            @Info
            @Actions
        </div>
    </div>

    @ChildContent
</section>

@code {
    /// <summary>Identificador da secção (único na página).</summary>
    [Parameter, EditorRequired] public string Id { get; set; } = "";

    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>Ocupa a largura toda da grelha.</summary>
    [Parameter] public bool Wide { get; set; }

    /// <summary>Classes extra da secção.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Informação ao lado do título (ex.: "3 reservas", "1 de 4 feitas").</summary>
    [Parameter] public RenderFragment? Info { get; set; }

    /// <summary>Botões do cabeçalho (ex.: "+ Reserva").</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string Css => "card plan-section" + (Wide ? " plan-wide" : "") + (Class is null ? "" : " " + Class);
}
