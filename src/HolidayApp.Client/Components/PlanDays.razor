@* Day-by-day plan: one card per day, with that day's lodging, bookings and places. *@

<PlanSection Id="days" Title="Day by day" Wide="true">
    <Info><span class="muted small">@Display.Days(Days.Count)</span></Info>
    <ChildContent>

    <ol class="day-plan">
        @foreach (var day in Days)
        {
            var d = day;
            <li class="@DayCss(d.Date)" aria-current="@(d.Date == Today ? "date" : null)">
                <div class="day-date">
                    <strong>@(d.Date == Today ? $"Today · {Display.Long(d.Date)}" : Display.Long(d.Date))</strong>
                    <span class="muted small">Day @(d.Date.DayNumber - TripStart.DayNumber + 1)</span>
                </div>

                @{ var stays = Places.Where(p => p.StaysOn(d.Date) && !string.IsNullOrWhiteSpace(p.Name)).ToList(); }
                @if (stays.Count > 0)
                {
                    <ul class="plain-list day-items" aria-label="Lodging on this day">
                        @foreach (var stay in stays)
                        {
                            <li class="day-stay" title="Lodging">
                                <span class="place-number small-pin kind-lodging">
                                    <PlaceIcon />
                                </span>
                                <span class="day-item-name">@stay.Name</span>
                            </li>
                        }
                    </ul>
                }

                @{ var dayBookings = BookingsOn(d.Date); }
                @if (dayBookings.Count > 0)
                {
                    <ul class="plain-list day-items" aria-label="Bookings on this day">
                        @foreach (var booking in dayBookings)
                        {
                            <li>
                                <span class="tag">@Display.Label(booking.Type)</span>
                                <span class="day-item-name">@booking.Name</span>
                                @if (!string.IsNullOrWhiteSpace(booking.Reference))
                                {
                                    <span class="muted small">@booking.Reference</span>
                                }
                            </li>
                        }
                    </ul>
                }

                @{ var dayPlaces = PlacesOn(d.Date); }
                @if (dayPlaces.Count > 0)
                {
                    <ul class="plain-list day-items" aria-label="Places on this day">
                        @foreach (var (place, number) in dayPlaces)
                        {
                            <li class="@(place.Visited ? "day-place visited" : "day-place")" title="@Display.Label(place.Kind)">
                                @if (place.IsVisit)
                                {
                                    <span class="place-number small-pin">@number</span>
                                }
                                else
                                {
                                    <span class="place-number small-pin @PlaceIcons.Css(place.Kind)"><PlaceIcon Kind="place.Kind" /></span>
                                }
                                <span class="day-item-name">@place.Name</span>
                            </li>
                        }
                    </ul>
                }

                <input class="input" placeholder="Where? (e.g. Lagos)" aria-label="Place"
                       maxlength="@VacationPlanValidator.ShortTextMaxLength" @bind="d.Place" @bind:after="ChangedAsync" />
                <textarea class="input" rows="2" placeholder="Activities, restaurants, times…" aria-label="Activities"
                          maxlength="@VacationPlanValidator.ActivitiesMaxLength" @bind="d.Activities" @bind:after="ChangedAsync"></textarea>
            </li>
        }
    </ol>
    </ChildContent>
</PlanSection>

@code {
    /// <summary>One item per vacation day (already filled in by the page).</summary>
    [Parameter, EditorRequired] public List<PlanDayDto> Days { get; set; } = [];
    [Parameter, EditorRequired] public List<PlanBookingDto> Bookings { get; set; } = [];
    [Parameter, EditorRequired] public List<PlanPlaceDto> Places { get; set; } = [];
    [Parameter] public DateOnly TripStart { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>Today (can be swapped in tests): during the trip, its card is highlighted.</summary>
    [Parameter] public DateOnly Today { get; set; } = DateOnly.FromDateTime(DateTime.Today);

    private string DayCss(DateOnly date) =>
        "day-card" + (WorkdayCalculator.IsWeekend(date) ? " weekend" : "") + (date == Today ? " today" : "");

    /// <summary>Bookings for this day (those without a name yet are left out).</summary>
    private List<PlanBookingDto> BookingsOn(DateOnly date) =>
        Bookings.Where(b => b.Date == date && !string.IsNullOrWhiteSpace(b.Name)).ToList();

    /// <summary>Places and transport for this day (in route order), with their number on the map.</summary>

    private List<(PlanPlaceDto Place, int? Number)> PlacesOn(DateOnly date) =>
        Places.Zip(PlanPlaceDto.Numbers(Places))
            .Where(x => !x.First.IsLodging && x.First.Date == date && !string.IsNullOrWhiteSpace(x.First.Name))
            .Select(x => (x.First, x.Second))
            .ToList();

    private Task ChangedAsync() => OnChanged.InvokeAsync();
}
