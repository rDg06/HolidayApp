@* Dialog to create, edit or delete an entry. *@

<div class="modal-backdrop" @onclick="CloseAsync">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="editor-title"
         @onclick:stopPropagation="true" @onkeydown="OnKeyDownAsync">
        <form @onsubmit="SubmitAsync">
            <header class="modal-header">
                <h2 id="editor-title">@(Existing is null ? "New entry" : "Edit entry")</h2>
                <button type="button" class="btn icon" aria-label="Close" @onclick="CloseAsync">✕</button>
            </header>

            <div class="modal-body">
                <label class="field">
                    <span>Title</span>
                    <input class="input" @ref="_titleInput" @bind="_title" @bind:event="oninput"
                           maxlength="@CalendarEventValidator.TitleMaxLength" />
                </label>

                <div class="type-picker" role="radiogroup" aria-label="Type">
                    @foreach (var type in Enum.GetValues<EventType>())
                    {
                        var t = type;
                        <button type="button" role="radio" aria-checked="@(_type == t ? "true" : "false")"
                                class="@ChipCss(t)"
                                @onclick="() => SelectType(t)">
                            <span class="swatch"></span>@Display.Label(t)
                        </button>
                    }
                </div>

                <div class="field-row">
                    <label class="field">
                        <span>From</span>
                        <input class="input" type="date" @bind="_start" @bind:format="yyyy-MM-dd" @bind:after="OnStartChanged" />
                    </label>
                    <label class="field">
                        <span>To</span>
                        <input class="input" type="date" @bind="_end" @bind:format="yyyy-MM-dd" />
                    </label>
                </div>

                @if (_type == EventType.Vacation)
                {
                    <p class="workdays">
                        Counts as <strong>@Display.Workdays(Workdays)</strong> of vacation
                        <span class="muted">(weekends and holidays do not count)</span>
                    </p>
                }

                @* Saves the entry (new or changed) and opens the planning page *@
                @if (_type == EventType.Vacation)
                {
                    <button type="button" class="organize-link" disabled="@Busy" @onclick="OrganizeAsync">
                        <span>
                            <strong>@(Existing is null ? "Save and plan vacation" : "Plan vacation")</strong>
                            <span class="muted small">Bookings, map, day-by-day plan, tasks and budget</span>
                        </span>
                        <span aria-hidden="true">→</span>
                    </button>
                }

                <label class="field">
                    <span>Notes <span class="muted">(optional)</span></span>
                    <textarea class="input" rows="2" @bind="_notes" maxlength="@CalendarEventValidator.NotesMaxLength"></textarea>
                </label>

                @if (_errors.Count > 0 || !string.IsNullOrEmpty(Error))
                {
                    <ul class="form-errors" role="alert">
                        @foreach (var message in _errors)
                        {
                            <li>@message</li>
                        }
                        @if (!string.IsNullOrEmpty(Error))
                        {
                            <li>@Error</li>
                        }
                    </ul>
                }
            </div>

            <footer class="modal-footer">
                @if (Existing is not null)
                {
                    <button type="button" class="btn danger" disabled="@Busy" @onclick="DeleteClickedAsync">
                        @(_confirmDelete ? "Confirm: delete" : "Delete")
                    </button>
                }
                <span class="spacer"></span>
                <button type="button" class="btn ghost" @onclick="CloseAsync">Cancel</button>
                <button type="submit" class="btn primary" disabled="@Busy">@(Busy ? "Saving…" : "Save")</button>
            </footer>
        </form>
    </div>
</div>

@code {
    [Parameter] public CalendarEventDto? Existing { get; set; }
    [Parameter] public DateOnly InitialStart { get; set; }
    [Parameter] public DateOnly InitialEnd { get; set; }
    [Parameter] public IReadOnlySet<DateOnly> HolidayDates { get; set; } = new HashSet<DateOnly>();
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? Error { get; set; }

    [Parameter] public EventCallback<SaveCalendarEventRequest> OnSave { get; set; }

    /// <summary>Save and then open the "Plan vacation" page.</summary>
    [Parameter] public EventCallback<SaveCalendarEventRequest> OnSaveAndOrganize { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private ElementReference _titleInput;
    private string _title = "";
    private EventType _type = EventType.Vacation;
    private DateOnly _start;
    private DateOnly _end;
    private string? _notes;
    private bool _confirmDelete;
    private List<string> _errors = [];

    private int Workdays => WorkdayCalculator.CountWorkdays(_start, _end, HolidayDates);

    private string ChipCss(EventType type) => $"chip {Display.Css(type)}{(_type == type ? " active" : "")}";

    protected override void OnInitialized()
    {
        if (Existing is not null)
        {
            _title = Existing.Title;
            _type = Existing.Type;
            _start = Existing.StartDate;
            _end = Existing.EndDate;
            _notes = Existing.Notes;
        }
        else
        {
            _title = Display.Label(EventType.Vacation);
            _start = InitialStart;
            _end = InitialEnd < InitialStart ? InitialStart : InitialEnd;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await _titleInput.FocusAsync();
    }

    private void SelectType(EventType type)
    {
        // If the title is still the default text, it follows the chosen type
        var isDefaultTitle = string.IsNullOrWhiteSpace(_title)
                             || Enum.GetValues<EventType>().Any(t => Display.Label(t) == _title);
        _type = type;
        if (isDefaultTitle)
            _title = Display.Label(type);
    }

    private void OnStartChanged()
    {
        if (_end < _start)
            _end = _start;
    }

    private async Task SubmitAsync()
    {
        if (BuildValidRequest() is { } request)
            await OnSave.InvokeAsync(request);
    }

    private async Task OrganizeAsync()
    {
        if (BuildValidRequest() is { } request)
            await OnSaveAndOrganize.InvokeAsync(request);
    }

    /// <summary>Builds the request from the form; null (and visible errors) if it is invalid.</summary>
    private SaveCalendarEventRequest? BuildValidRequest()
    {
        var request = new SaveCalendarEventRequest(
            _title.Trim(),
            _start,
            _end,
            _type,
            string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim());

        _errors = CalendarEventValidator.Validate(request).SelectMany(kv => kv.Value).ToList();
        return _errors.Count > 0 ? null : request;
    }

    private async Task DeleteClickedAsync()
    {
        if (!_confirmDelete)
        {
            _confirmDelete = true;
            return;
        }

        await OnDelete.InvokeAsync();
    }

    private Task CloseAsync() => OnClose.InvokeAsync();

    private Task OnKeyDownAsync(KeyboardEventArgs e) =>
        e.Key == "Escape" ? CloseAsync() : Task.CompletedTask;
}
