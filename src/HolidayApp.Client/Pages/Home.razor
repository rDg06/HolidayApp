@page "/"
@inject ICalendarApi Api

<PageTitle>HolidayApp · @_year</PageTitle>

<div class="planner" @onmouseup="FinishDrag">

    <div class="toolbar">
        <div class="year-nav">
            <button type="button" class="btn icon" aria-label="Ano anterior" @onclick="() => ChangeYearAsync(_year - 1)">‹</button>
            <h1>@_year</h1>
            <button type="button" class="btn icon" aria-label="Ano seguinte" @onclick="() => ChangeYearAsync(_year + 1)">›</button>
            @if (_year != _today.Year)
            {
                <button type="button" class="btn ghost" @onclick="() => ChangeYearAsync(_today.Year)">Ano atual</button>
            }
        </div>
        <div class="toolbar-actions">
            <span class="hint">Clica num dia ou arrasta sobre vários para marcar</span>
            <button type="button" class="btn primary" @onclick="() => OpenCreator(DefaultNewDate, DefaultNewDate)">+ Marcar férias</button>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="alert" role="alert">
            <span>@_error</span>
            <button type="button" class="btn ghost small" @onclick="LoadAsync">Tentar de novo</button>
        </div>
    }

    <div class="layout">
        <section class="@(_loading ? "year-grid is-loading" : "year-grid")" aria-label="Calendário">
            @for (var m = 1; m <= 12; m++)
            {
                var month = m;
                <MonthGrid Year="_year"
                           Month="month"
                           Days="_dayMap"
                           Today="_today"
                           SelectionStart="SelectionMin"
                           SelectionEnd="SelectionMax"
                           OnDayPointerDown="OnDayDown"
                           OnDayPointerOver="OnDayOver"
                           OnDayActivated="OnDayActivated" />
            }
        </section>

        <aside class="sidebar">
            <div class="card summary">
                <span class="label">Férias por gozar</span>
                <div class="summary-figure">
                    <span class="@(Remaining < 0 ? "big negative" : "big")">@Remaining</span>
                    <span class="muted">de @AnnualDays dias úteis</span>
                </div>
                <div class="progress" role="progressbar" aria-label="Dias de férias usados"
                     aria-valuemin="0" aria-valuemax="@AnnualDays" aria-valuenow="@UsedDays">
                    <div class="progress-bar" style="width: @(ProgressPercent)%"></div>
                </div>
                <p class="muted small">@Pt.Workdays(UsedDays) marcados em @_year</p>
            </div>

            <div class="card legend">
                <span class="legend-item"><span class="swatch ev-ferias"></span>Férias</span>
                <span class="legend-item"><span class="swatch ev-pessoal"></span>Pessoal</span>
                <span class="legend-item"><span class="swatch ev-outro"></span>Outro</span>
                <span class="legend-item"><span class="swatch holiday"></span>Feriado</span>
                <span class="legend-item"><span class="swatch today"></span>Hoje</span>
            </div>

            @if (UpcomingBridges.Count > 0)
            {
                <div class="card">
                    <h3>Pontes possíveis</h3>
                    <ul class="plain-list">
                        @foreach (var bridge in UpcomingBridges)
                        {
                            var b = bridge;
                            <li class="bridge">
                                <div>
                                    <strong>@Pt.Long(b.SuggestedDayOff)</strong>
                                    <span class="muted small">@b.HolidayName · @b.ConsecutiveDaysOff dias seguidos</span>
                                </div>
                                @if (b.AlreadyBooked)
                                {
                                    <span class="tag">Marcada</span>
                                }
                                else
                                {
                                    <button type="button" class="btn small" disabled="@_busy" @onclick="() => BookBridgeAsync(b)">Marcar</button>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }

            <div class="card">
                <h3>Marcações</h3>
                @if (_events.Count == 0)
                {
                    <p class="muted small">Ainda não tens nada marcado em @_year.</p>
                }
                else
                {
                    <ul class="plain-list">
                        @foreach (var ev in _events)
                        {
                            var item = ev;
                            <li>
                                <button type="button" class="event-item" @onclick="() => OpenEditor(item)">
                                    <span class="@($"swatch {Pt.Css(item.Type)}")"></span>
                                    <span class="event-text">
                                        <strong>@item.Title</strong>
                                        <span class="muted small">@Pt.Range(item.StartDate, item.EndDate)@WorkdaysSuffix(item)</span>
                                    </span>
                                </button>
                            </li>
                        }
                    </ul>
                }
            </div>

            <details class="card">
                <summary><h3>Feriados de @_year</h3></summary>
                <ul class="plain-list holidays">
                    @foreach (var holiday in _holidays)
                    {
                        <li class="@(holiday.Date < _today ? "past" : null)">
                            <span class="holiday-date">@Pt.Long(holiday.Date)</span>
                            <span>@holiday.Name</span>
                        </li>
                    }
                </ul>
            </details>
        </aside>
    </div>

    @if (_editorOpen)
    {
        <EventEditor Existing="_editing"
                     InitialStart="_newStart"
                     InitialEnd="_newEnd"
                     HolidayDates="_holidayDates"
                     Busy="_busy"
                     Error="_editorError"
                     OnSave="SaveAsync"
                     OnDelete="DeleteAsync"
                     OnClose="CloseEditor" />
    }
</div>

@code {
    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);
    private int _year;
    private int _loadVersion;

    // Dados
    private bool _loading = true;
    private string? _error;
    private List<HolidayDto> _holidays = [];
    private List<CalendarEventDto> _events = [];
    private YearSummaryDto? _summary;
    private Dictionary<DateOnly, DayInfo> _dayMap = new();
    private HashSet<DateOnly> _holidayDates = [];

    // Arrastar para selecionar
    private bool _dragging;
    private DateOnly? _dragAnchor;
    private DateOnly? _dragCurrent;

    // Editor
    private bool _editorOpen;
    private bool _busy;
    private CalendarEventDto? _editing;
    private DateOnly _newStart;
    private DateOnly _newEnd;
    private string? _editorError;

    private int AnnualDays => _summary?.AnnualVacationDays ?? 0;
    private int UsedDays => _summary?.UsedVacationDays ?? 0;
    private int Remaining => _summary?.RemainingVacationDays ?? 0;

    private int ProgressPercent =>
        AnnualDays <= 0 ? 0 : Math.Clamp((int)Math.Round(UsedDays * 100.0 / AnnualDays), 0, 100);

    private List<BridgeSuggestionDto> UpcomingBridges =>
        _summary?.Bridges.Where(b => b.SuggestedDayOff >= _today).ToList() ?? [];

    private DateOnly? SelectionMin =>
        _dragAnchor is { } a && _dragCurrent is { } c ? (a < c ? a : c) : (DateOnly?)null;

    private DateOnly? SelectionMax =>
        _dragAnchor is { } a && _dragCurrent is { } c ? (a > c ? a : c) : (DateOnly?)null;

    private DateOnly DefaultNewDate => _year == _today.Year ? _today : new DateOnly(_year, 1, 2);

    protected override async Task OnInitializedAsync()
    {
        _year = _today.Year;
        await LoadAsync();
    }

    // ---------- Carregar dados ----------

    private async Task LoadAsync()
    {
        var version = ++_loadVersion;
        var year = _year;
        _loading = true;
        _error = null;

        try
        {
            var holidaysTask = Api.GetHolidaysAsync(year);
            var eventsTask = Api.GetEventsAsync(year);
            var summaryTask = Api.GetSummaryAsync(year);

            var holidays = await holidaysTask;
            var events = await eventsTask;
            var summary = await summaryTask;

            // Se o utilizador já mudou de ano entretanto, ignora esta resposta
            if (version != _loadVersion)
                return;

            _holidays = holidays.ToList();
            _events = events.ToList();
            _summary = summary;
            BuildDayMap();
        }
        catch (Exception ex)
        {
            if (version == _loadVersion)
                _error = $"Não foi possível carregar os dados. {ex.Message}";
        }
        finally
        {
            if (version == _loadVersion)
                _loading = false;
        }
    }

    private void BuildDayMap()
    {
        var map = new Dictionary<DateOnly, DayInfo>();

        DayInfo Get(DateOnly date)
        {
            if (!map.TryGetValue(date, out var info))
            {
                info = new DayInfo();
                map[date] = info;
            }
            return info;
        }

        foreach (var holiday in _holidays)
            Get(holiday.Date).Holiday ??= holiday;

        var yearStart = new DateOnly(_year, 1, 1);
        var yearEnd = new DateOnly(_year, 12, 31);

        // Férias primeiro: em dias com várias marcações, é a cor que aparece
        foreach (var ev in _events.OrderBy(e => e.Type).ThenBy(e => e.StartDate))
        {
            var from = ev.StartDate < yearStart ? yearStart : ev.StartDate;
            var to = ev.EndDate > yearEnd ? yearEnd : ev.EndDate;
            for (var day = from; day <= to; day = day.AddDays(1))
                Get(day).Events.Add(ev);
        }

        _dayMap = map;
        _holidayDates = _holidays.Select(h => h.Date).ToHashSet();
    }

    private async Task ChangeYearAsync(int year)
    {
        if (year == _year)
            return;

        _year = year;
        ResetDrag();
        await LoadAsync();
    }

    // ---------- Seleção com o rato ----------

    private void OnDayDown(DateOnly date)
    {
        _dragging = true;
        _dragAnchor = date;
        _dragCurrent = date;
    }

    private void OnDayOver(DayPointer pointer)
    {
        if (!_dragging)
            return;

        // O botão foi largado fora da página: cancela a seleção
        if (pointer.Buttons == 0)
        {
            ResetDrag();
            return;
        }

        _dragCurrent = pointer.Date;
    }

    private void FinishDrag()
    {
        if (!_dragging || SelectionMin is not { } start || SelectionMax is not { } end)
            return;

        ResetDrag();

        // Clique simples num dia já marcado → editar essa marcação
        if (start == end && _dayMap.TryGetValue(start, out var info) && info.Events.Count > 0)
        {
            OpenEditor(info.Events[0]);
            return;
        }

        OpenCreator(start, end);
    }

    private void ResetDrag()
    {
        _dragging = false;
        _dragAnchor = null;
        _dragCurrent = null;
    }

    private void OnDayActivated(DateOnly date)
    {
        if (_dayMap.TryGetValue(date, out var info) && info.Events.Count > 0)
            OpenEditor(info.Events[0]);
        else
            OpenCreator(date, date);
    }

    // ---------- Editor ----------

    private void OpenCreator(DateOnly start, DateOnly end)
    {
        _editing = null;
        _newStart = start;
        _newEnd = end;
        _editorError = null;
        _editorOpen = true;
    }

    private void OpenEditor(CalendarEventDto ev)
    {
        _editing = ev;
        _newStart = ev.StartDate;
        _newEnd = ev.EndDate;
        _editorError = null;
        _editorOpen = true;
    }

    private void CloseEditor()
    {
        _editorOpen = false;
        _editing = null;
    }

    private async Task SaveAsync(SaveCalendarEventRequest request)
    {
        _busy = true;
        _editorError = null;
        try
        {
            if (_editing is null)
                await Api.CreateEventAsync(request);
            else
                await Api.UpdateEventAsync(_editing.Id, request);

            CloseEditor();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _editorError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_editing is null)
            return;

        _busy = true;
        _editorError = null;
        try
        {
            await Api.DeleteEventAsync(_editing.Id);
            CloseEditor();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _editorError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task BookBridgeAsync(BridgeSuggestionDto bridge)
    {
        _busy = true;
        try
        {
            var request = new SaveCalendarEventRequest(
                $"Ponte · {bridge.HolidayName}",
                bridge.SuggestedDayOff,
                bridge.SuggestedDayOff,
                EventType.Ferias,
                null);

            await Api.CreateEventAsync(request);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível marcar a ponte. {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private string WorkdaysSuffix(CalendarEventDto ev) =>
        ev.Type == EventType.Ferias
            ? $" · {Pt.Workdays(WorkdayCalculator.CountWorkdays(ev.StartDate, ev.EndDate, _holidayDates))}"
            : "";
}
