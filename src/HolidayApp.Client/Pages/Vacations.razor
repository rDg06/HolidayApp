@page "/vacations"
@inject ICalendarApi Api

<PageTitle>Vacations · HolidayApp</PageTitle>

<div class="vacations-page">
    <header class="vacations-header">
        <h1>My vacations</h1>
        @* The working days are only for my own vacations (not the trips friends added me to) *@
        @if (Mine.Count > 0)
        {
            <p class="muted">
                @Display.Workdays(Mine.Sum(v => v.Workdays)) in @(Mine.Count == 1 ? "1 period" : $"{Mine.Count} periods")
                @if (Mine.Count < _vacations!.Count)
                {
                    <span> · @(_vacations.Count - Mine.Count) shared with you</span>
                }
            </p>
        }
    </header>

    @if (_vacations is null)
    {
        if (_loadError is not null)
        {
            <div class="alert" role="alert">
                <span>@_loadError</span>
                <button type="button" class="btn ghost small" @onclick="LoadAsync">Try again</button>
            </div>
        }
        else
        {
            <p class="muted">Loading…</p>
        }
    }
    else if (_vacations.Count == 0)
    {
        <div class="card empty-state">
            <p>No vacations booked yet.</p>
            <a class="btn primary" href="calendar">Go to the calendar</a>
        </div>
    }
    else
    {
        @if (Upcoming.Count > 0)
        {
            <section aria-labelledby="upcoming-title" class="vacations-section">
                <h2 id="upcoming-title">Upcoming and ongoing</h2>
                <div class="vacation-grid">
                    @foreach (var v in Upcoming)
                    {
                        @VacationCard(v)
                    }
                </div>
            </section>
        }

        @if (Past.Count > 0)
        {
            <section aria-labelledby="past-title" class="vacations-section">
                <h2 id="past-title">Past</h2>
                <div class="vacation-grid">
                    @foreach (var v in Past)
                    {
                        @VacationCard(v)
                    }
                </div>
            </section>
        }
    }
</div>

@code {
    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);
    private List<VacationSummaryDto>? _vacations;
    private string? _loadError;

    // Upcoming: nearest first. Past: most recent first.
    private List<VacationSummaryDto> Upcoming =>
        _vacations?.Where(v => v.EndDate >= _today).OrderBy(v => v.StartDate).ToList() ?? [];

    private List<VacationSummaryDto> Mine => _vacations?.Where(v => v.Role == TripRole.Owner).ToList() ?? [];

    /// <summary>Who can edit opens the plan; who can only view opens the summary.</summary>
    private static string Href(VacationSummaryDto v) =>
        v.CanEdit ? $"vacations/{v.Id}?from=vacations" : $"vacations/{v.Id}/share?from=vacations";

    private static string People(int count) => count == 1 ? "+1 person" : $"+{count} people";

    private List<VacationSummaryDto> Past =>
        _vacations?.Where(v => v.EndDate < _today).OrderByDescending(v => v.StartDate).ToList() ?? [];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loadError = null;
        try
        {
            _vacations = (await Api.GetVacationsAsync()).ToList();
        }
        catch (Exception ex)
        {
            _loadError = $"Could not load the vacations. {ex.Message}";
        }
    }

    private string Status(VacationSummaryDto v)
    {
        if (v.EndDate < _today)
            return "Finished";
        if (v.StartDate <= _today)
            return "Ongoing";

        var days = v.StartDate.DayNumber - _today.DayNumber;
        return days == 1 ? "Tomorrow" : $"In {days} days";
    }

    private static string Years(VacationSummaryDto v) =>
        v.StartDate.Year == v.EndDate.Year ? $"{v.StartDate.Year}" : $"{v.StartDate.Year}–{v.EndDate.Year}";

    private RenderFragment VacationCard(VacationSummaryDto v) => __builder =>
    {
        var status = Status(v);
        <a class="card vacation-card @(status == "Ongoing" ? "current" : null)" href="@Href(v)">
            <div class="vacation-top">
                <div class="vacation-title">
                    <strong>@v.Title</strong>
                    <span class="muted small">@Display.Range(v.StartDate, v.EndDate) @Years(v)</span>
                </div>
                <span class="@(status == "Finished" ? "tag muted-tag" : "tag")">@status</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(v.Destination))
            {
                <p class="vacation-destination">@v.Destination</p>
            }

            @* Whose trip and who sees it *@
            <div class="vacation-sharing">
                @if (v.IsShared)
                {
                    <span class="tag shared-tag">@(v.Owner?.Name ?? "Someone")'s trip</span>
                    <span class="muted small">@(v.CanEdit ? "you can edit" : "view only")</span>
                }
                else
                {
                    <span class="@(v.IsPublic ? "tag" : "tag muted-tag")">@(v.IsPublic ? "Public" : "Private")</span>
                    @if (v.People > 0)
                    {
                        <span class="muted small">@People(v.People)</span>
                    }
                }
            </div>

            <dl class="vacation-stats">
                @* Total vacation days (with weekends and holidays) and, below, the working days used *@
                <div>
                    <dt>Days</dt>
                    <dd>@(v.EndDate.DayNumber - v.StartDate.DayNumber + 1) <span class="stat-sub">@v.Workdays working</span></dd>
                </div>
                <div><dt>Bookings</dt><dd>@v.Bookings</dd></div>
                <div>
                    <dt>Places</dt>
                    <dd>
                        @v.Places
                        @if (v.PlacesVisited > 0)
                        {
                            <span class="stat-sub">@(v.PlacesVisited == 1 ? "1 visited" : $"{v.PlacesVisited} visited")</span>
                        }
                    </dd>
                </div>
                <div><dt>Tasks</dt><dd>@(v.Tasks == 0 ? "0" : $"{v.TasksDone}/{v.Tasks}")</dd></div>
                <div class="wide">
                    <dt>Budget</dt>
                    <dd>
                        @Display.Money(v.Planned)
                        @if (v.Spent > 0)
                        {
                            <span class="@(v.Spent > v.Planned ? "muted small over" : "muted small")"> · spent @Display.Money(v.Spent)</span>
                        }
                    </dd>
                </div>
            </dl>

            <span class="vacation-open">@(v.CanEdit ? "Plan →" : "See trip →")</span>
        </a>
    };
}
