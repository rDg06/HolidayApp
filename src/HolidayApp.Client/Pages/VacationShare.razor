@page "/vacations/{Id:guid}/share"
@inject ICalendarApi Api
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IAsyncDisposable

@* Trip summary to share with friends: "Save PDF" opens the browser's print dialog
   (where you choose "Save as PDF"). Amounts, references and notes only show if chosen.
   It is also how people who can only view a trip (added as "view only", or a public trip) see it. *@

<PageTitle>@(_event is null ? "Share vacation" : $"{_event.Title} · {Display.Range(_event.StartDate, _event.EndDate)}")</PageTitle>

<div class="share-page">
    <div class="share-toolbar no-print">
        <a class="back-link" href="@BackLink.Href">@BackLink.Label</a>

        @if (_event is not null && _plan is not null)
        {
            <fieldset class="share-options">
                <legend class="visually-hidden">What to show in the PDF</legend>
                <label class="check small"><input type="checkbox" @bind="_showNotes" /> Notes</label>
                <label class="check small"><input type="checkbox" @bind="_showMoney" /> Amounts (€)</label>
                <label class="check small"><input type="checkbox" @bind="_showCodes" /> Booking references and links</label>
            </fieldset>
            <button type="button" class="btn primary" @onclick="PrintAsync">Save PDF</button>
        }
    </div>

    @if (_event is null || _plan is null)
    {
        if (_loadError is not null)
        {
            <div class="alert" role="alert">@_loadError</div>
        }
        else
        {
            <p class="muted">Loading…</p>
        }
    }
    else
    {
        @if (_sharing is { IsOwner: false })
        {
            <p class="share-owner no-print">
                <span class="tag">@(_sharing.IsPublic && _sharing.MyRole == TripRole.PublicViewer ? "Public trip" : "Shared with you")</span>
                <span>by <strong>@_sharing.Owner.Name</strong> <span class="muted">@@@_sharing.Owner.Username</span></span>
                @if (!_sharing.CanEdit)
                {
                    <span class="muted small">· view only</span>
                }
            </p>
        }

        @if (_sharing is { MyRole: TripRole.Viewer })
        {
            <div class="no-print">
                <TripSharing EventId="Id" @bind-Sharing="_sharing" MyUsername="@_myUsername" OnLeft="Left" />
            </div>
        }

        <p class="share-hint muted small no-print">
            In "Save PDF" choose <strong>Save as PDF</strong> as the destination (on a phone: Share → Print).
            Booking amounts and references only show if you choose them above.
        </p>

        <article class="share-doc">
            <header class="share-header">
                <h1>@_event.Title</h1>
                <p>
                    @Display.Range(_event.StartDate, _event.EndDate) · @Display.Days(DayCount)
                    @if (!string.IsNullOrWhiteSpace(_plan.Destination))
                    {
                        <span> · @_plan.Destination</span>
                    }
                </p>
            </header>

            @if (_plan.Places.Count > 0)
            {
                <section class="share-section">
                    <div class="share-map" @ref="_mapElement" aria-label="Trip map"></div>
                    <ul class="plain-list share-legend" aria-label="Map legend">
                        @foreach (var (place, number) in _plan.Places.Zip(PlanPlaceDto.Numbers(_plan.Places)))
                        {
                            <li>
                                <Pin Place="place" Number="number" />
                                <span>@place.Name</span>
                            </li>
                        }
                    </ul>
                </section>
            }

            <section class="share-section">
                <h2>Day by day</h2>
                <ol class="plain-list share-days">
                    @for (var day = _event.StartDate; day <= _event.EndDate; day = day.AddDays(1))
                    {
                        var d = day;
                        var route = PlaceRoute.ForDay(_plan.Places, d);
                        var routed = _routes.GetValueOrDefault(d);
                        var bookings = _plan.Bookings.Where(b => b.Date == d && !string.IsNullOrWhiteSpace(b.Name)).ToList();
                        var notes = _plan.Days.FirstOrDefault(x => x.Date == d);

                        <li class="share-day">
                            <h3>
                                <span>Day @(d.DayNumber - _event.StartDate.DayNumber + 1)</span>
                                <span class="muted">@Display.Long(d)</span>
                                @if (routed is not null)
                                {
                                    <span class="share-km muted">@Display.Km(routed.Distance / 1000) · @Display.Duration(routed.Duration) @Display.Label(_plan.RouteMode)</span>
                                }
                                else if (route.Count > 1)
                                {
                                    <span class="share-km muted">@Display.Km(PlaceRoute.TotalKm(route)) straight-line</span>
                                }
                            </h3>

                            @if (!string.IsNullOrWhiteSpace(notes?.Place))
                            {
                                <p class="share-day-place">@notes.Place</p>
                            }

                            @if (bookings.Count > 0)
                            {
                                <ul class="plain-list share-items">
                                    @foreach (var b in bookings)
                                    {
                                        <li><span class="tag">@Display.Label(b.Type)</span> @b.Name @BookingExtras(b)</li>
                                    }
                                </ul>
                            }

                            @if (route.Count > 0)
                            {
                                <ol class="plain-list share-items share-route">
                                    @for (var i = 0; i < route.Count; i++)
                                    {
                                        var stop = route[i];
                                        var leg = routed is not null && i > 0 ? routed.Legs[i - 1] : null;
                                        <li>
                                            <Pin Place="stop.Place" Number="NumberOf(stop.Place)" />
                                            <span>
                                                @stop.Place.Name
                                                @if (leg is not null)
                                                {
                                                    <span class="muted small"> · @Display.Km(leg.Distance / 1000) · @Display.Duration(leg.Duration)</span>
                                                }
                                                else if (stop.KmFromPrevious is { } km)
                                                {
                                                    <span class="muted small"> · @Display.Km(km)</span>
                                                }
                                                @if (_showNotes && !string.IsNullOrWhiteSpace(stop.Place.Notes))
                                                {
                                                    <span class="share-note">@stop.Place.Notes</span>
                                                }
                                            </span>
                                        </li>
                                    }
                                </ol>
                            }

                            @if (!string.IsNullOrWhiteSpace(notes?.Activities))
                            {
                                <p class="share-activities">@notes.Activities</p>
                            }

                            @if (route.Count == 0 && bookings.Count == 0 && string.IsNullOrWhiteSpace(notes?.Place) && string.IsNullOrWhiteSpace(notes?.Activities))
                            {
                                <p class="muted small">Free day.</p>
                            }
                        </li>
                    }
                </ol>
            </section>

            @{ var noDay = _plan.Places.Where(p => p.Date is null).ToList(); }
            @if (noDay.Count > 0)
            {
                <section class="share-section">
                    <h2>Other places</h2>
                    <ul class="plain-list share-items">
                        @foreach (var place in noDay)
                        {
                            <li>
                                <Pin Place="place" Number="NumberOf(place)" />
                                <span>
                                    @place.Name
                                    <span class="muted small"> · @(place.IsTransport ? $"{Display.Label(place.Kind)} (every day)" : Display.Label(place.Kind))</span>
                                    @if (_showNotes && !string.IsNullOrWhiteSpace(place.Notes))
                                    {
                                        <span class="share-note">@place.Notes</span>
                                    }
                                </span>
                            </li>
                        }
                    </ul>
                </section>
            }

            @if (_plan.Bookings.Any(b => !string.IsNullOrWhiteSpace(b.Name)))
            {
                <section class="share-section">
                    <h2>Bookings</h2>
                    <ul class="plain-list share-items">
                        @foreach (var b in _plan.Bookings.Where(b => !string.IsNullOrWhiteSpace(b.Name)).OrderBy(b => b.Date ?? DateOnly.MaxValue))
                        {
                            <li>
                                <span class="tag">@Display.Label(b.Type)</span>
                                @b.Name
                                @if (b.Date is { } date)
                                {
                                    <span class="muted small"> · @Display.Long(date)</span>
                                }
                                @BookingExtras(b)
                                @if (_showNotes && !string.IsNullOrWhiteSpace(b.Notes))
                                {
                                    <span class="share-note">@b.Notes</span>
                                }
                            </li>
                        }
                    </ul>
                </section>
            }

            @if (_showMoney && _plan.SpentByCategory() is { Count: > 0 } spent)
            {
                <section class="share-section">
                    <h2>Spending</h2>
                    <table class="share-money">
                        <tbody>
                            @foreach (var c in spent.OrderByDescending(c => c.Amount))
                            {
                                <tr><th scope="row">@Display.Label(c.Category)</th><td>@Display.Money(c.Amount)</td></tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr><th scope="row">Total</th><td>@Display.Money(spent.Sum(c => c.Amount))</td></tr>
                        </tfoot>
                    </table>
                </section>
            }

            <footer class="share-footer muted small">Made with HolidayApp · maps © OpenStreetMap</footer>
        </article>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private CalendarEventDto? _event;
    private VacationPlanDto? _plan;
    private string? _loadError;

    // What goes into the PDF: by default, no money and no references (it is for sharing)
    private bool _showNotes = true;
    private bool _showMoney;
    private bool _showCodes;

    private ElementReference _mapElement;
    private IJSObjectReference? _module;
    private IJSObjectReference? _map;
    private bool _mapCreated;

    /// <summary>Each day's street route (those not back yet stay straight-line).</summary>
    private readonly Dictionary<DateOnly, RouteResult> _routes = [];

    /// <summary>Where you came from ("vacations", "map", "explore"), for the back link.</summary>
    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }

    private TripSharingDto? _sharing;
    private string? _myUsername;

    /// <summary>Who can edit goes back to the plan; who can only view goes back to where they came from.</summary>
    private (string Href, string Label) BackLink => _sharing is null || _sharing.CanEdit
        ? ($"vacations/{Id}", "← Plan vacation")
        : From switch
        {
            "map" => ("", "← Map"),
            "explore" => ("explore", "← Explore"),
            _ => ("vacations", "← Vacations"),
        };

    private void Left() => Navigation.NavigateTo(From == "explore" ? "explore" : "vacations");

    private int DayCount => _event is null ? 0 : _event.EndDate.DayNumber - _event.StartDate.DayNumber + 1;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var eventTask = Api.GetEventAsync(Id);
            var planTask = Api.GetPlanAsync(Id);
            var sharingTask = Api.GetSharingAsync(Id);
            var meTask = Api.GetMeAsync();
            _event = await eventTask;
            _plan = await planTask;
            _sharing = await sharingTask;
            _myUsername = (await meTask)?.Username;
        }
        catch (Exception ex)
        {
            _loadError = $"Could not load the vacation. {ex.Message}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_mapCreated || _plan is not { Places.Count: > 0 })
            return;

        _mapCreated = true;
        try
        {
            // Read-only map with every place (everyday transport does not pull the zoom)
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/plan-map.js");
            var markers = MapMarkers.Build(_plan.Places, _ => true, p => p.IsTransport && p.Date is null);
            _map = await _module.InvokeAsync<IJSObjectReference>("create", _mapElement, null, markers, null, new { readOnly = true });
        }
        catch (JSDisconnectedException)
        {
            return;
        }
        catch (Exception)
        {
            // No map (e.g. no internet): the rest of the summary still works
        }

        await LoadRoutesAsync();
    }

    /// <summary>Asks for the street route of each day with two or more places (one day at a time).</summary>
    private async Task LoadRoutesAsync()
    {
        if (_module is null || _event is null || _plan is null)
            return;

        for (var day = _event.StartDate; day <= _event.EndDate; day = day.AddDays(1))
        {
            var stops = PlaceRoute.ForDay(_plan.Places, day).Select(s => s.Place).ToList();
            if (stops.Count < 2)
                continue;

            try
            {
                if (await Routing.GetAsync(_module, stops, _plan.RouteMode) is { } routed)
                {
                    _routes[day] = routed;
                    StateHasChanged();
                }
            }
            catch (Exception)
            {
                return; // no service: the days stay straight-line
            }
        }
    }

    private int? NumberOf(PlanPlaceDto place) => PlanPlaceDto.Numbers(_plan!.Places)[_plan.Places.IndexOf(place)];

    /// <summary>A booking's reference, link and cost, only if chosen.</summary>
    private RenderFragment BookingExtras(PlanBookingDto b) => __builder =>
    {
        if (_showCodes && !string.IsNullOrWhiteSpace(b.Reference))
        {
            <span class="muted small"> · ref. @b.Reference</span>
        }
        if (_showMoney && b.Cost is > 0)
        {
            <span class="muted small"> · @Display.Money(b.Cost.Value)</span>
        }
        if (_showCodes && VacationPlanValidator.IsSafeUrl(b.Url))
        {
            <span class="share-note"><a href="@b.Url!.Trim()" target="_blank" rel="noopener noreferrer">@b.Url!.Trim()</a></span>
        }
    };

    private async Task PrintAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("print");
        }
        catch (JSException)
        {
            // Browser without printing: nothing to do
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_map is not null)
            {
                await _map.InvokeVoidAsync("dispose");
                await _map.DisposeAsync();
            }

            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
