@page "/ferias/{Id:guid}/partilhar"
@inject ICalendarApi Api
@inject IJSRuntime JS
@implements IAsyncDisposable

@* Resumo da viagem para partilhar com amigos: "Guardar PDF" abre a impressão do navegador
   (onde se escolhe "Guardar como PDF"). Valores, códigos e notas só aparecem se se escolher. *@

<PageTitle>@(_event is null ? "Partilhar férias" : $"{_event.Title} · {Pt.Range(_event.StartDate, _event.EndDate)}")</PageTitle>

<div class="share-page">
    <div class="share-toolbar no-print">
        <a class="back-link" href="@($"ferias/{Id}")">← Organizar férias</a>

        @if (_event is not null && _plan is not null)
        {
            <fieldset class="share-options">
                <legend class="visually-hidden">O que mostrar no PDF</legend>
                <label class="check small"><input type="checkbox" @bind="_showNotes" /> Notas</label>
                <label class="check small"><input type="checkbox" @bind="_showMoney" /> Valores (€)</label>
                <label class="check small"><input type="checkbox" @bind="_showCodes" /> Códigos e ligações das reservas</label>
            </fieldset>
            <button type="button" class="btn primary" @onclick="PrintAsync">Guardar PDF</button>
        }
    </div>

    @if (_event is null || _plan is null)
    {
        if (_loadError is not null)
        {
            <div class="alert" role="alert">@_loadError</div>
        }
        else
        {
            <p class="muted">A carregar…</p>
        }
    }
    else
    {
        <p class="share-hint muted small no-print">
            No "Guardar PDF" escolhe <strong>Guardar como PDF</strong> como destino (no telemóvel: Partilhar → Imprimir).
            Os valores e os códigos das reservas só aparecem se os escolheres acima.
        </p>

        <article class="share-doc">
            <header class="share-header">
                <h1>@_event.Title</h1>
                <p>
                    @Pt.Range(_event.StartDate, _event.EndDate) · @Pt.Days(DayCount)
                    @if (!string.IsNullOrWhiteSpace(_plan.Destination))
                    {
                        <span> · @_plan.Destination</span>
                    }
                </p>
            </header>

            @if (_plan.Places.Count > 0)
            {
                <section class="share-section">
                    <div class="share-map" @ref="_mapElement" aria-label="Mapa da viagem"></div>
                    <ul class="plain-list share-legend" aria-label="Legenda do mapa">
                        @foreach (var (place, number) in _plan.Places.Zip(PlanPlaceDto.Numbers(_plan.Places)))
                        {
                            <li>
                                <Pin Place="place" Number="number" />
                                <span>@place.Name</span>
                            </li>
                        }
                    </ul>
                </section>
            }

            <section class="share-section">
                <h2>Dia a dia</h2>
                <ol class="plain-list share-days">
                    @for (var day = _event.StartDate; day <= _event.EndDate; day = day.AddDays(1))
                    {
                        var d = day;
                        var route = PlaceRoute.ForDay(_plan.Places, d);
                        var routed = _routes.GetValueOrDefault(d);
                        var bookings = _plan.Bookings.Where(b => b.Date == d && !string.IsNullOrWhiteSpace(b.Name)).ToList();
                        var notes = _plan.Days.FirstOrDefault(x => x.Date == d);

                        <li class="share-day">
                            <h3>
                                <span>Dia @(d.DayNumber - _event.StartDate.DayNumber + 1)</span>
                                <span class="muted">@Pt.Long(d)</span>
                                @if (routed is not null)
                                {
                                    <span class="share-km muted">@Pt.Km(routed.Distance / 1000) · @Pt.Duration(routed.Duration) @Pt.Label(_plan.RouteMode)</span>
                                }
                                else if (route.Count > 1)
                                {
                                    <span class="share-km muted">@Pt.Km(PlaceRoute.TotalKm(route)) em linha reta</span>
                                }
                            </h3>

                            @if (!string.IsNullOrWhiteSpace(notes?.Place))
                            {
                                <p class="share-day-place">@notes.Place</p>
                            }

                            @if (bookings.Count > 0)
                            {
                                <ul class="plain-list share-items">
                                    @foreach (var b in bookings)
                                    {
                                        <li><span class="tag">@Pt.Label(b.Type)</span> @b.Name @BookingExtras(b)</li>
                                    }
                                </ul>
                            }

                            @if (route.Count > 0)
                            {
                                <ol class="plain-list share-items share-route">
                                    @for (var i = 0; i < route.Count; i++)
                                    {
                                        var stop = route[i];
                                        var leg = routed is not null && i > 0 ? routed.Legs[i - 1] : null;
                                        <li>
                                            <Pin Place="stop.Place" Number="NumberOf(stop.Place)" />
                                            <span>
                                                @stop.Place.Name
                                                @if (leg is not null)
                                                {
                                                    <span class="muted small"> · @Pt.Km(leg.Distance / 1000) · @Pt.Duration(leg.Duration)</span>
                                                }
                                                else if (stop.KmFromPrevious is { } km)
                                                {
                                                    <span class="muted small"> · @Pt.Km(km)</span>
                                                }
                                                @if (_showNotes && !string.IsNullOrWhiteSpace(stop.Place.Notes))
                                                {
                                                    <span class="share-note">@stop.Place.Notes</span>
                                                }
                                            </span>
                                        </li>
                                    }
                                </ol>
                            }

                            @if (!string.IsNullOrWhiteSpace(notes?.Activities))
                            {
                                <p class="share-activities">@notes.Activities</p>
                            }

                            @if (route.Count == 0 && bookings.Count == 0 && string.IsNullOrWhiteSpace(notes?.Place) && string.IsNullOrWhiteSpace(notes?.Activities))
                            {
                                <p class="muted small">Dia livre.</p>
                            }
                        </li>
                    }
                </ol>
            </section>

            @{ var noDay = _plan.Places.Where(p => p.Date is null).ToList(); }
            @if (noDay.Count > 0)
            {
                <section class="share-section">
                    <h2>Outros locais</h2>
                    <ul class="plain-list share-items">
                        @foreach (var place in noDay)
                        {
                            <li>
                                <Pin Place="place" Number="NumberOf(place)" />
                                <span>
                                    @place.Name
                                    <span class="muted small"> · @(place.IsTransport ? $"{Pt.Label(place.Kind)} (todos os dias)" : Pt.Label(place.Kind))</span>
                                    @if (_showNotes && !string.IsNullOrWhiteSpace(place.Notes))
                                    {
                                        <span class="share-note">@place.Notes</span>
                                    }
                                </span>
                            </li>
                        }
                    </ul>
                </section>
            }

            @if (_plan.Bookings.Any(b => !string.IsNullOrWhiteSpace(b.Name)))
            {
                <section class="share-section">
                    <h2>Reservas</h2>
                    <ul class="plain-list share-items">
                        @foreach (var b in _plan.Bookings.Where(b => !string.IsNullOrWhiteSpace(b.Name)).OrderBy(b => b.Date ?? DateOnly.MaxValue))
                        {
                            <li>
                                <span class="tag">@Pt.Label(b.Type)</span>
                                @b.Name
                                @if (b.Date is { } date)
                                {
                                    <span class="muted small"> · @Pt.Long(date)</span>
                                }
                                @BookingExtras(b)
                                @if (_showNotes && !string.IsNullOrWhiteSpace(b.Notes))
                                {
                                    <span class="share-note">@b.Notes</span>
                                }
                            </li>
                        }
                    </ul>
                </section>
            }

            @if (_showMoney && _plan.SpentByCategory() is { Count: > 0 } spent)
            {
                <section class="share-section">
                    <h2>Gastos</h2>
                    <table class="share-money">
                        <tbody>
                            @foreach (var c in spent.OrderByDescending(c => c.Amount))
                            {
                                <tr><th scope="row">@Pt.Label(c.Category)</th><td>@Pt.Money(c.Amount)</td></tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr><th scope="row">Total</th><td>@Pt.Money(spent.Sum(c => c.Amount))</td></tr>
                        </tfoot>
                    </table>
                </section>
            }

            <footer class="share-footer muted small">Feito com HolidayApp · mapas © OpenStreetMap</footer>
        </article>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private CalendarEventDto? _event;
    private VacationPlanDto? _plan;
    private string? _loadError;

    // O que entra no PDF: por omissão, nada de dinheiro nem códigos (é para partilhar)
    private bool _showNotes = true;
    private bool _showMoney;
    private bool _showCodes;

    private ElementReference _mapElement;
    private IJSObjectReference? _module;
    private IJSObjectReference? _map;
    private bool _mapCreated;

    /// <summary>Caminho por ruas de cada dia (os que ainda não chegaram ficam em linha reta).</summary>
    private readonly Dictionary<DateOnly, RouteResult> _routes = [];

    private int DayCount => _event is null ? 0 : _event.EndDate.DayNumber - _event.StartDate.DayNumber + 1;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var eventTask = Api.GetEventAsync(Id);
            var planTask = Api.GetPlanAsync(Id);
            _event = await eventTask;
            _plan = await planTask;
        }
        catch (Exception ex)
        {
            _loadError = $"Não foi possível carregar as férias. {ex.Message}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_mapCreated || _plan is not { Places.Count: > 0 })
            return;

        _mapCreated = true;
        try
        {
            // Mapa só de leitura com todos os locais (transportes de todos os dias não puxam o zoom)
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/plan-map.js");
            var markers = MapMarkers.Build(_plan.Places, _ => true, p => p.IsTransport && p.Date is null);
            _map = await _module.InvokeAsync<IJSObjectReference>("create", _mapElement, null, markers, null, new { readOnly = true });
        }
        catch (JSDisconnectedException)
        {
            return;
        }
        catch (Exception)
        {
            // Sem mapa (ex.: sem internet): o resto do resumo continua a servir
        }

        await LoadRoutesAsync();
    }

    /// <summary>Pede o caminho por ruas de cada dia com dois ou mais locais (um dia de cada vez).</summary>
    private async Task LoadRoutesAsync()
    {
        if (_module is null || _event is null || _plan is null)
            return;

        for (var day = _event.StartDate; day <= _event.EndDate; day = day.AddDays(1))
        {
            var stops = PlaceRoute.ForDay(_plan.Places, day).Select(s => s.Place).ToList();
            if (stops.Count < 2)
                continue;

            try
            {
                if (await Routing.GetAsync(_module, stops, _plan.RouteMode) is { } routed)
                {
                    _routes[day] = routed;
                    StateHasChanged();
                }
            }
            catch (Exception)
            {
                return; // sem serviço: os dias ficam em linha reta
            }
        }
    }

    private int? NumberOf(PlanPlaceDto place) => PlanPlaceDto.Numbers(_plan!.Places)[_plan.Places.IndexOf(place)];

    /// <summary>Código, ligação e valor de uma reserva, só se escolhidos.</summary>
    private RenderFragment BookingExtras(PlanBookingDto b) => __builder =>
    {
        if (_showCodes && !string.IsNullOrWhiteSpace(b.Reference))
        {
            <span class="muted small"> · código @b.Reference</span>
        }
        if (_showMoney && b.Cost is > 0)
        {
            <span class="muted small"> · @Pt.Money(b.Cost.Value)</span>
        }
        if (_showCodes && VacationPlanValidator.IsSafeUrl(b.Url))
        {
            <span class="share-note"><a href="@b.Url!.Trim()" target="_blank" rel="noopener noreferrer">@b.Url!.Trim()</a></span>
        }
    };

    private async Task PrintAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("print");
        }
        catch (JSException)
        {
            // Navegador sem impressão: nada a fazer
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_map is not null)
            {
                await _map.InvokeVoidAsync("dispose");
                await _map.DisposeAsync();
            }

            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
