@page "/settings"
@inject ICalendarApi Api

<PageTitle>Profile and settings · HolidayApp</PageTitle>

<div class="settings-page">
    <h1>Profile and settings</h1>

    @* Profile: name, user name, password, sign out, data *@
    <AccountSection />

    <h2 class="settings-title">Settings</h2>
    <p class="muted">These options change the holidays shown and the vacation balance.</p>

    @if (_model is null)
    {
        if (_loadError is not null)
        {
            <div class="alert" role="alert">@_loadError</div>
        }
        else
        {
            <p class="muted">Loading…</p>
        }
    }
    else
    {
        <form class="card settings-form" @onsubmit="SaveAsync">
            <label class="field">
                <span>Working days of vacation per year</span>
                <input class="input narrow" type="number" min="0" max="@SettingsValidator.MaxAnnualVacationDays"
                       @bind="_model.AnnualVacationDays" />
                <small class="muted">In Portugal, the legal minimum is 22 working days.</small>
            </label>

            <label class="check">
                <input type="checkbox" @bind="_model.IncludeCarnival" />
                <span>I get Carnival off (counts as a non-working day)</span>
            </label>

            <fieldset class="fieldset">
                <legend>Municipal holiday</legend>
                <label class="field">
                    <span>Name</span>
                    <input class="input" placeholder="e.g. Saint Anthony" maxlength="@SettingsValidator.MunicipalNameMaxLength"
                           @bind="_model.MunicipalHolidayName" />
                </label>
                <div class="field-row">
                    <label class="field">
                        <span>Month</span>
                        <select class="input" @bind="_model.MunicipalHolidayMonth">
                            <option value="">None</option>
                            @for (var i = 1; i <= 12; i++)
                            {
                                var month = i;
                                <option value="@month">@Display.Months[month - 1]</option>
                            }
                        </select>
                    </label>
                    <label class="field">
                        <span>Day</span>
                        <input class="input" type="number" min="1" max="31" @bind="_model.MunicipalHolidayDay" />
                    </label>
                </div>
            </fieldset>

            @if (_errors.Count > 0)
            {
                <ul class="form-errors" role="alert">
                    @foreach (var message in _errors)
                    {
                        <li>@message</li>
                    }
                </ul>
            }

            <div class="form-actions">
                <button type="submit" class="btn primary" disabled="@_saving">@(_saving ? "Saving…" : "Save")</button>
                @if (_saved)
                {
                    <span class="saved" role="status">Saved ✓</span>
                }
            </div>
        </form>
    }
</div>

@code {
    private UserSettingsDto? _model;
    private string? _loadError;
    private List<string> _errors = [];
    private bool _saving;
    private bool _saved;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _model = await Api.GetSettingsAsync();
        }
        catch (Exception ex)
        {
            _loadError = $"Could not load the settings. {ex.Message}";
        }
    }

    private async Task SaveAsync()
    {
        if (_model is null)
            return;

        _saved = false;
        _errors = SettingsValidator.Validate(_model).SelectMany(kv => kv.Value).ToList();
        if (_errors.Count > 0)
            return;

        _saving = true;
        try
        {
            _model = await Api.SaveSettingsAsync(_model);
            _saved = true;
        }
        catch (Exception ex)
        {
            _errors = [ex.Message];
        }
        finally
        {
            _saving = false;
        }
    }
}
