@page "/ferias/{Id:guid}"
@inject ICalendarApi Api
@inject IJSRuntime JS
@inject NavigationManager Navigation
@using System.Text.Json

<PageTitle>Organizar férias · HolidayApp</PageTitle>

<NavigationLock ConfirmExternalNavigation="IsDirty" OnBeforeInternalNavigation="ConfirmLeaveAsync" />

<div class="plan-page">
    @* Volta para onde se veio: a lista de férias ou o calendário *@
    <a class="back-link" href="@(From == "ferias" ? "ferias" : "")">@(From == "ferias" ? "← Férias" : "← Calendário")</a>

    @if (_event is null || _plan is null)
    {
        if (_loadError is not null)
        {
            <div class="alert" role="alert">@_loadError</div>
        }
        else
        {
            <p class="muted">A carregar…</p>
        }
    }
    else
    {
        <header class="plan-header">
            <div class="plan-title">
                <h1>@_event.Title</h1>
                <p class="muted">
                    @Pt.Range(_event.StartDate, _event.EndDate) · @Pt.Days(_days.Count)
                    @if (_today >= _event.StartDate && _today <= _event.EndDate)
                    {
                        <span class="tag travelling">Em viagem · dia @(_today.DayNumber - _event.StartDate.DayNumber + 1)</span>
                    }
                </p>
            </div>
            <div class="plan-save">
                @{ var dirty = IsDirty; }
                @if (_saved && !dirty)
                {
                    <span class="saved" role="status">Guardado ✓</span>
                }
                else if (dirty)
                {
                    <span class="muted small" role="status">Alterações por guardar</span>
                }
                <button type="button" class="btn" disabled="@_saving" title="Resumo para partilhar com amigos (guarda primeiro, se for preciso)"
                        @onclick="ShareAsync">Partilhar (PDF)</button>
                <button type="button" class="btn primary" disabled="@_saving" @onclick="SaveAsync">
                    @(_saving ? "A guardar…" : "Guardar")
                </button>
            </div>
        </header>

        @Errors

        @* Separadores: só o separador escolhido é desenhado (os dados ficam em _plan, nada se perde) *@
        <div class="plan-tabs" role="tablist" aria-label="Partes do planeamento" @onkeydown="OnTabKeyDown">
            @foreach (var tab in Tabs)
            {
                var t = tab;
                var selected = _tab == t.Key;
                <button @ref="_tabButtons[t.Key]" type="button" role="tab" id="@($"tab-{t.Key}")" aria-controls="@($"panel-{t.Key}")"
                        aria-selected="@(selected ? "true" : "false")" tabindex="@(selected ? 0 : -1)"
                        class="@(selected ? "plan-tab selected" : "plan-tab")" @onclick="() => SelectTab(t.Key)">
                    @t.Label
                    @if (t.Count is { } count)
                    {
                        <span class="plan-tab-count">@count</span>
                    }
                </button>
            }
        </div>

        <div class="plan-grid" role="tabpanel" id="@($"panel-{_tab}")" aria-labelledby="@($"tab-{_tab}")">
            @switch (_tab)
            {
                case PlanTab.Locais:
                    <section class="card plan-section plan-wide">
                        <label class="field">
                            <span>Destino</span>
                            <input class="input" placeholder="ex.: Algarve, Roma, Açores…" maxlength="@VacationPlanValidator.DestinationMaxLength"
                                   @bind="_plan.Destination" />
                        </label>
                    </section>

                    <PlanSection Id="places" Title="Locais a visitar" Wide="true">
                        <Info>
                            @{ var toVisit = _plan.Places.Where(p => p.IsVisit).ToList(); }
                            @if (toVisit.Count > 0)
                            {
                                <span class="muted small">@toVisit.Count(p => p.Visited) de @toVisit.Count visitados</span>
                            }
                        </Info>
                        <ChildContent>
                            <PlaceMap @ref="_placeMap"
                                      Places="_plan.Places"
                                      TripStart="_event.StartDate"
                                      TripEnd="_event.EndDate"
                                      Destination="@_plan.Destination"
                                      @bind-RouteMode="_plan.RouteMode"
                                      OnChanged="StateHasChanged" />
                        </ChildContent>
                    </PlanSection>
                    break;

                case PlanTab.Reservas:
                    <PlanBookings Bookings="_plan.Bookings" Places="_plan.Places" TripStart="_event.StartDate" TripEnd="_event.EndDate"
                                  OnChanged="StateHasChanged" OnPutOnMap="PutLodgingOnMapAsync" />
                    break;

                case PlanTab.Tarefas:
                    <PlanTasks Tasks="_plan.Tasks" OnChanged="StateHasChanged" />
                    break;

                case PlanTab.Orcamento:
                    <PlanBudget Expenses="_plan.Expenses" Bookings="_plan.Bookings" OnChanged="StateHasChanged" />
                    @* Atualiza enquanto se edita o orçamento *@
                    <SpendingChart Amounts="_plan.SpentByCategory()" />
                    break;

                default:
                    <PlanDays Days="_days" Bookings="_plan.Bookings" Places="_plan.Places" TripStart="_event.StartDate" OnChanged="StateHasChanged" />
                    break;
            }
        </div>

        @* Os erros também aparecem aqui, junto ao segundo botão "Guardar" *@
        @Errors

        <div class="plan-footer">
            <button type="button" class="btn primary" disabled="@_saving" @onclick="SaveAsync">
                @(_saving ? "A guardar…" : "Guardar")
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    /// <summary>De onde se veio ("ferias" = lista de férias), para o link de voltar.</summary>
    [SupplyParameterFromQuery(Name = "de")] public string? From { get; set; }

    private CalendarEventDto? _event;
    private VacationPlanDto? _plan;
    private PlaceMap? _placeMap;
    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);
    private List<PlanDayDto> _days = [];
    private string? _loadError;
    private List<string> _errors = [];
    private string? _savedState;
    private bool _saving;
    private bool _saved;

    /// <summary>
    /// Há alterações por guardar quando o conteúdo atual difere do último que
    /// foi carregado ou guardado. Comparar o estado apanha qualquer campo, sem
    /// depender de eventos (o "change" não sobe aos elementos pai no Blazor).
    /// </summary>
    private bool IsDirty => _plan is not null && CurrentState() != _savedState;

    private string CurrentState() =>
        JsonSerializer.Serialize(new { _plan!.Destination, _plan.RouteMode, _plan.Bookings, _plan.Tasks, _plan.Expenses, _plan.Places, Days = _days });

    private RenderFragment Errors => __builder =>
    {
        if (_errors.Count > 0)
        {
            <ul class="form-errors" role="alert">
                @foreach (var message in _errors)
                {
                    <li>@message</li>
                }
            </ul>
        }
    };

    protected override async Task OnParametersSetAsync()
    {
        // Só volta a carregar quando muda a marcação (não quando muda o "?de=")
        if (_event?.Id == Id)
            return;

        _event = null;
        _plan = null;
        _loadError = null;
        _saved = false;
        _errors = [];

        try
        {
            var eventTask = Api.GetEventAsync(Id);
            var planTask = Api.GetPlanAsync(Id);
            _event = await eventTask;
            _plan = await planTask;
            BuildDays();
            _savedState = CurrentState();
        }
        catch (Exception ex)
        {
            _loadError = $"Não foi possível carregar o planeamento. {ex.Message}";
        }
    }

    /// <summary>Um bloco por cada dia das férias, com o que já estava guardado.</summary>
    private void BuildDays()
    {
        var saved = _plan!.Days.ToDictionary(d => d.Date);
        _days = [];
        for (var date = _event!.StartDate; date <= _event.EndDate; date = date.AddDays(1))
            _days.Add(saved.GetValueOrDefault(date) ?? new PlanDayDto { Date = date });
    }

    private async Task SaveAsync()
    {
        if (_plan is null)
            return;

        // Linhas deixadas em branco não contam como erro: são simplesmente ignoradas
        _plan.Tasks.RemoveAll(t => string.IsNullOrWhiteSpace(t.Text));
        _plan.Bookings.RemoveAll(b => string.IsNullOrWhiteSpace(b.Name) && string.IsNullOrWhiteSpace(b.Reference)
                                      && string.IsNullOrWhiteSpace(b.Url) && string.IsNullOrWhiteSpace(b.Notes)
                                      && b.Cost is null);
        _plan.Expenses.RemoveAll(e => string.IsNullOrWhiteSpace(e.Description) && e.Planned is null && e.Actual is null);
        _plan.Days = _days.Where(d => !string.IsNullOrWhiteSpace(d.Place) || !string.IsNullOrWhiteSpace(d.Activities)).ToList();

        _errors = VacationPlanValidator.Validate(_plan, _event!.StartDate, _event.EndDate).SelectMany(kv => kv.Value).ToList();
        if (_errors.Count > 0)
            return;

        _saving = true;
        try
        {
            _plan = await Api.SavePlanAsync(Id, _plan);
            BuildDays();
            _savedState = CurrentState();
            _saved = true;
        }
        catch (Exception ex)
        {
            _errors = [ex.Message];
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        if (IsDirty && !await JS.InvokeAsync<bool>("confirm", "Tens alterações por guardar. Sair sem guardar?"))
            context.PreventNavigation();
    }

    /// <summary>
    /// Reserva de alojamento → vai para o separador Locais e procura-a no mapa (fica como
    /// alojamento a partir do dia da reserva). A procura corre quando o mapa aparecer.
    /// </summary>
    private Task PutLodgingOnMapAsync(PlanBookingDto booking)
    {
        _pendingLodging = booking;
        _tab = PlanTab.Locais;
        return Task.CompletedTask;
    }

    /// <summary>Abre o resumo para partilhar/PDF. Guarda antes, porque o resumo mostra o que está guardado.</summary>
    private async Task ShareAsync()
    {
        if (IsDirty)
        {
            await SaveAsync();
            if (IsDirty)
                return; // não guardou (erros à vista)
        }

        Navigation.NavigateTo($"ferias/{Id}/partilhar");
    }

    // ---------- Separadores ----------

    private enum PlanTab { Locais, Reservas, Tarefas, Orcamento, DiaADia }

    private sealed record TabInfo(PlanTab Key, string Label, string? Count);

    private PlanTab _tab = PlanTab.Locais;

    private readonly Dictionary<PlanTab, ElementReference> _tabButtons = [];

    /// <summary>Reserva de alojamento à espera que o mapa apareça para ser procurada.</summary>
    private PlanBookingDto? _pendingLodging;

    private IEnumerable<TabInfo> Tabs
    {
        get
        {
            var visits = _plan!.Places.Count(p => p.IsVisit);
            var bookings = _plan.Bookings.Count;
            var tasks = _plan.Tasks.Count;
            yield return new(PlanTab.Locais, "Locais", visits > 0 ? visits.ToString() : null);
            yield return new(PlanTab.Reservas, "Reservas", bookings > 0 ? bookings.ToString() : null);
            yield return new(PlanTab.Tarefas, "Tarefas", tasks > 0 ? $"{_plan.Tasks.Count(t => t.Done)}/{tasks}" : null);
            yield return new(PlanTab.Orcamento, "Orçamento", null);
            yield return new(PlanTab.DiaADia, "Dia a dia", null);
        }
    }

    private void SelectTab(PlanTab tab) => _tab = tab;

    /// <summary>Setas ← → (e Início/Fim) mudam de separador, como nos separadores normais.</summary>
    private async Task OnTabKeyDown(KeyboardEventArgs e)
    {
        var all = Enum.GetValues<PlanTab>();
        var index = Array.IndexOf(all, _tab);
        var next = e.Key switch
        {
            "ArrowRight" => (index + 1) % all.Length,
            "ArrowLeft" => (index - 1 + all.Length) % all.Length,
            "Home" => 0,
            "End" => all.Length - 1,
            _ => -1,
        };
        if (next < 0)
            return;

        _tab = all[next];
        StateHasChanged();
        try
        {
            await _tabButtons[_tab].FocusAsync();
        }
        catch (Exception)
        {
            // Sem foco (ex.: nos testes): o separador mudou na mesma
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // "Pôr no mapa" numa reserva: abriu o separador Locais, agora já há mapa
        if (_pendingLodging is { } booking && _placeMap is not null)
        {
            _pendingLodging = null;
            await _placeMap.FindLodgingAsync(booking.Name, booking.Date);
        }
    }
}
