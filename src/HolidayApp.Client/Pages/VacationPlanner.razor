@page "/vacations/{Id:guid}"
@inject ICalendarApi Api
@inject IJSRuntime JS
@inject NavigationManager Navigation
@using System.Text.Json

<PageTitle>Plan vacation · HolidayApp</PageTitle>

<NavigationLock ConfirmExternalNavigation="IsDirty" OnBeforeInternalNavigation="ConfirmLeaveAsync" />

<div class="plan-page">
    @* Goes back to where you came from: the vacation list, the map or the calendar *@
    <a class="back-link" href="@BackLink.Href">@BackLink.Label</a>

    @if (_event is null || _plan is null)
    {
        if (_loadError is not null)
        {
            <div class="alert" role="alert">@_loadError</div>
        }
        else
        {
            <p class="muted">Loading…</p>
        }
    }
    else
    {
        <header class="plan-header">
            <div class="plan-title">
                <h1>@_event.Title</h1>
                <p class="muted">
                    @Display.Range(_event.StartDate, _event.EndDate) · @Display.Days(_days.Count)
                    @if (_today >= _event.StartDate && _today <= _event.EndDate)
                    {
                        <span class="tag travelling">Travelling · day @(_today.DayNumber - _event.StartDate.DayNumber + 1)</span>
                    }
                </p>
            </div>
            <div class="plan-save">
                @{ var dirty = IsDirty; }
                @if (_saved && !dirty)
                {
                    <span class="saved" role="status">Saved ✓</span>
                }
                else if (dirty)
                {
                    <span class="muted small" role="status">Unsaved changes</span>
                }
                <button type="button" class="btn" disabled="@_saving" title="Summary to share with friends (saves first, if needed)"
                        @onclick="ShareAsync">Share (PDF)</button>
                <button type="button" class="btn primary" disabled="@_saving" @onclick="SaveAsync">
                    @(_saving ? "Saving…" : "Save")
                </button>
            </div>
        </header>

        @Errors

        @* Tabs: only the chosen tab is rendered (the data stays in _plan, nothing is lost) *@
        <div class="plan-tabs" role="tablist" aria-label="Parts of the plan" @onkeydown="OnTabKeyDown">
            @foreach (var tab in Tabs)
            {
                var t = tab;
                var selected = _tab == t.Key;
                <button @ref="_tabButtons[t.Key]" type="button" role="tab" id="@($"tab-{t.Key}")" aria-controls="@($"panel-{t.Key}")"
                        aria-selected="@(selected ? "true" : "false")" tabindex="@(selected ? 0 : -1)"
                        class="@(selected ? "plan-tab selected" : "plan-tab")" @onclick="() => SelectTab(t.Key)">
                    @t.Label
                    @if (t.Count is { } count)
                    {
                        <span class="plan-tab-count">@count</span>
                    }
                </button>
            }
        </div>

        <div class="plan-grid" role="tabpanel" id="@($"panel-{_tab}")" aria-labelledby="@($"tab-{_tab}")">
            @switch (_tab)
            {
                case PlanTab.Places:
                    <section class="card plan-section plan-wide">
                        <label class="field">
                            <span>Destination</span>
                            <input class="input" placeholder="e.g. Algarve, Rome, Azores…" maxlength="@VacationPlanValidator.DestinationMaxLength"
                                   @bind="_plan.Destination" />
                        </label>
                    </section>

                    <PlanSection Id="places" Title="Places to visit" Wide="true">
                        <Info>
                            @{ var toVisit = _plan.Places.Where(p => p.IsVisit).ToList(); }
                            @if (toVisit.Count > 0)
                            {
                                <span class="muted small">@toVisit.Count(p => p.Visited) of @toVisit.Count visited</span>
                            }
                        </Info>
                        <ChildContent>
                            <PlaceMap @ref="_placeMap"
                                      Places="_plan.Places"
                                      TripStart="_event.StartDate"
                                      TripEnd="_event.EndDate"
                                      Destination="@_plan.Destination"
                                      @bind-RouteMode="_plan.RouteMode"
                                      OnChanged="StateHasChanged" />
                        </ChildContent>
                    </PlanSection>
                    break;

                case PlanTab.Bookings:
                    <PlanBookings Bookings="_plan.Bookings" Places="_plan.Places" TripStart="_event.StartDate" TripEnd="_event.EndDate"
                                  OnChanged="StateHasChanged" OnPutOnMap="PutLodgingOnMapAsync" />
                    break;

                case PlanTab.Tasks:
                    <PlanTasks Tasks="_plan.Tasks" OnChanged="StateHasChanged" />
                    break;

                case PlanTab.Budget:
                    <PlanBudget Expenses="_plan.Expenses" Bookings="_plan.Bookings" OnChanged="StateHasChanged" />
                    @* Updates while the budget is edited *@
                    <SpendingChart Amounts="_plan.SpentByCategory()" />
                    break;

                default:
                    <PlanDays Days="_days" Bookings="_plan.Bookings" Places="_plan.Places" TripStart="_event.StartDate" OnChanged="StateHasChanged" />
                    break;
            }
        </div>

        @* Errors also show here, next to the second "Save" button *@
        @Errors

        <div class="plan-footer">
            <button type="button" class="btn primary" disabled="@_saving" @onclick="SaveAsync">
                @(_saving ? "Saving…" : "Save")
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    /// <summary>Back link: to the page you came from (Vacations, Map) or the calendar.</summary>
    private (string Href, string Label) BackLink => From switch
    {
        "vacations" => ("vacations", "← Vacations"),
        "map" => ("", "← Map"),
        _ => ("calendar", "← Calendar"),
    };

    /// <summary>Where you came from ("vacations" = vacation list, "map" = trips map), for the back link.</summary>
    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }

    private CalendarEventDto? _event;
    private VacationPlanDto? _plan;
    private PlaceMap? _placeMap;
    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);
    private List<PlanDayDto> _days = [];
    private string? _loadError;
    private List<string> _errors = [];
    private string? _savedState;
    private bool _saving;
    private bool _saved;

    /// <summary>
    /// There are unsaved changes when the current content differs from the last one
    /// loaded or saved. Comparing the state catches any field, without
    /// relying on events ("change" does not bubble up to parent elements in Blazor).
    /// </summary>
    private bool IsDirty => _plan is not null && CurrentState() != _savedState;

    private string CurrentState() =>
        JsonSerializer.Serialize(new { _plan!.Destination, _plan.RouteMode, _plan.Bookings, _plan.Tasks, _plan.Expenses, _plan.Places, Days = _days });

    private RenderFragment Errors => __builder =>
    {
        if (_errors.Count > 0)
        {
            <ul class="form-errors" role="alert">
                @foreach (var message in _errors)
                {
                    <li>@message</li>
                }
            </ul>
        }
    };

    protected override async Task OnParametersSetAsync()
    {
        // Only reloads when the entry changes (not when "?from=" changes)
        if (_event?.Id == Id)
            return;

        _event = null;
        _plan = null;
        _loadError = null;
        _saved = false;
        _errors = [];

        try
        {
            var eventTask = Api.GetEventAsync(Id);
            var planTask = Api.GetPlanAsync(Id);
            _event = await eventTask;
            _plan = await planTask;
            BuildDays();
            _savedState = CurrentState();
        }
        catch (Exception ex)
        {
            _loadError = $"Could not load the plan. {ex.Message}";
        }
    }

    /// <summary>One block per vacation day, with what was already saved.</summary>
    private void BuildDays()
    {
        var saved = _plan!.Days.ToDictionary(d => d.Date);
        _days = [];
        for (var date = _event!.StartDate; date <= _event.EndDate; date = date.AddDays(1))
            _days.Add(saved.GetValueOrDefault(date) ?? new PlanDayDto { Date = date });
    }

    private async Task SaveAsync()
    {
        if (_plan is null)
            return;

        // Rows left blank are not an error: they are simply ignored
        _plan.Tasks.RemoveAll(t => string.IsNullOrWhiteSpace(t.Text));
        _plan.Bookings.RemoveAll(b => string.IsNullOrWhiteSpace(b.Name) && string.IsNullOrWhiteSpace(b.Reference)
                                      && string.IsNullOrWhiteSpace(b.Url) && string.IsNullOrWhiteSpace(b.Notes)
                                      && b.Cost is null);
        _plan.Expenses.RemoveAll(e => string.IsNullOrWhiteSpace(e.Description) && e.Planned is null && e.Actual is null);
        _plan.Days = _days.Where(d => !string.IsNullOrWhiteSpace(d.Place) || !string.IsNullOrWhiteSpace(d.Activities)).ToList();

        _errors = VacationPlanValidator.Validate(_plan, _event!.StartDate, _event.EndDate).SelectMany(kv => kv.Value).ToList();
        if (_errors.Count > 0)
            return;

        _saving = true;
        try
        {
            _plan = await Api.SavePlanAsync(Id, _plan);
            BuildDays();
            _savedState = CurrentState();
            _saved = true;
        }
        catch (Exception ex)
        {
            _errors = [ex.Message];
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        if (IsDirty && !await JS.InvokeAsync<bool>("confirm", "You have unsaved changes. Leave without saving?"))
            context.PreventNavigation();
    }

    /// <summary>
    /// Lodging booking → goes to the Places tab and looks it up on the map (it becomes
    /// lodging from the booking day). The search runs when the map shows up.
    /// </summary>
    private Task PutLodgingOnMapAsync(PlanBookingDto booking)
    {
        _pendingLodging = booking;
        _tab = PlanTab.Places;
        return Task.CompletedTask;
    }

    /// <summary>Opens the share/PDF summary. Saves first, because the summary shows what is saved.</summary>
    private async Task ShareAsync()
    {
        if (IsDirty)
        {
            await SaveAsync();
            if (IsDirty)
                return; // not saved (errors on screen)
        }

        Navigation.NavigateTo($"vacations/{Id}/share");
    }

    // ---------- Tabs ----------

    private enum PlanTab { Places, Bookings, Tasks, Budget, DayByDay }

    private sealed record TabInfo(PlanTab Key, string Label, string? Count);

    private PlanTab _tab = PlanTab.Places;

    private readonly Dictionary<PlanTab, ElementReference> _tabButtons = [];

    /// <summary>Lodging booking waiting for the map to show up to be looked up.</summary>
    private PlanBookingDto? _pendingLodging;

    private IEnumerable<TabInfo> Tabs
    {
        get
        {
            var visits = _plan!.Places.Count(p => p.IsVisit);
            var bookings = _plan.Bookings.Count;
            var tasks = _plan.Tasks.Count;
            yield return new(PlanTab.Places, "Places", visits > 0 ? visits.ToString() : null);
            yield return new(PlanTab.Bookings, "Bookings", bookings > 0 ? bookings.ToString() : null);
            yield return new(PlanTab.Tasks, "Tasks", tasks > 0 ? $"{_plan.Tasks.Count(t => t.Done)}/{tasks}" : null);
            yield return new(PlanTab.Budget, "Budget", null);
            yield return new(PlanTab.DayByDay, "Day by day", null);
        }
    }

    private void SelectTab(PlanTab tab) => _tab = tab;

    /// <summary>← → arrows (and Home/End) change tab, like normal tabs.</summary>
    private async Task OnTabKeyDown(KeyboardEventArgs e)
    {
        var all = Enum.GetValues<PlanTab>();
        var index = Array.IndexOf(all, _tab);
        var next = e.Key switch
        {
            "ArrowRight" => (index + 1) % all.Length,
            "ArrowLeft" => (index - 1 + all.Length) % all.Length,
            "Home" => 0,
            "End" => all.Length - 1,
            _ => -1,
        };
        if (next < 0)
            return;

        _tab = all[next];
        StateHasChanged();
        try
        {
            await _tabButtons[_tab].FocusAsync();
        }
        catch (Exception)
        {
            // No focus (e.g. in tests): the tab changed anyway
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // "Put on map" on a booking: the Places tab opened, now there is a map
        if (_pendingLodging is { } booking && _placeMap is not null)
        {
            _pendingLodging = null;
            await _placeMap.FindLodgingAsync(booking.Name, booking.Date);
        }
    }
}
