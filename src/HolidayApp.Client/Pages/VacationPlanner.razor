@page "/ferias/{Id:guid}"
@inject ICalendarApi Api
@inject IJSRuntime JS
@using System.Text.Json

<PageTitle>Organizar férias · HolidayApp</PageTitle>

<NavigationLock ConfirmExternalNavigation="IsDirty" OnBeforeInternalNavigation="ConfirmLeaveAsync" />

<div class="plan-page">
    <a class="back-link" href="">← Calendário</a>

    @if (_event is null || _plan is null)
    {
        if (_loadError is not null)
        {
            <div class="alert" role="alert">@_loadError</div>
        }
        else
        {
            <p class="muted">A carregar…</p>
        }
    }
    else
    {
        <header class="plan-header">
            <div class="plan-title">
                <h1>@_event.Title</h1>
                <p class="muted">@Pt.Range(_event.StartDate, _event.EndDate) · @Pt.Days(_days.Count)</p>
            </div>
            <div class="plan-save">
                @{ var dirty = IsDirty; }
                @if (_saved && !dirty)
                {
                    <span class="saved" role="status">Guardado ✓</span>
                }
                else if (dirty)
                {
                    <span class="muted small" role="status">Alterações por guardar</span>
                }
                <button type="button" class="btn primary" disabled="@_saving" @onclick="SaveAsync">
                    @(_saving ? "A guardar…" : "Guardar")
                </button>
            </div>
        </header>

        @if (_errors.Count > 0)
        {
            <ul class="form-errors" role="alert">
                @foreach (var message in _errors)
                {
                    <li>@message</li>
                }
            </ul>
        }

        <div class="plan-grid">

            <section class="card plan-section plan-wide">
                <label class="field">
                    <span>Destino</span>
                    <input class="input" placeholder="ex.: Algarve, Roma, Açores…" maxlength="@VacationPlanValidator.DestinationMaxLength"
                           @bind="_plan.Destination" />
                </label>
            </section>

            @* ---------- Mapa ---------- *@
            <section class="card plan-section plan-wide" aria-labelledby="map-title">
                <div class="section-head">
                    <h2 id="map-title">Locais a visitar</h2>
                    @if (_plan.Places.Count > 0)
                    {
                        <span class="muted small">@_plan.Places.Count(p => p.Visited) de @_plan.Places.Count visitados</span>
                    }
                </div>
                <PlaceMap Places="_plan.Places"
                          TripStart="_event.StartDate"
                          TripEnd="_event.EndDate"
                          Destination="@_plan.Destination"
                          OnChanged="StateHasChanged" />
            </section>

            @* ---------- Reservas ---------- *@
            <section class="card plan-section plan-wide" aria-labelledby="bookings-title">
                <div class="section-head">
                    <h2 id="bookings-title">Reservas</h2>
                    <button type="button" class="btn small" @onclick="AddBooking">+ Reserva</button>
                </div>

                @if (_plan.Bookings.Count == 0)
                {
                    <p class="muted small">Voos, alojamento, aluguer de carro, bilhetes… Guarda aqui os códigos e as ligações.</p>
                }
                else
                {
                    <div class="booking-list">
                        @foreach (var booking in _plan.Bookings)
                        {
                            var b = booking;
                            <div class="booking-row">
                                <select class="input" aria-label="Tipo" @bind="b.Type">
                                    @foreach (var type in Enum.GetValues<BookingType>())
                                    {
                                        <option value="@type">@Pt.Label(type)</option>
                                    }
                                </select>
                                <input class="input" placeholder="Nome (ex.: Hotel Mar Azul)" aria-label="Nome"
                                       maxlength="@VacationPlanValidator.ShortTextMaxLength" @bind="b.Name" />
                                @* Só os dias das férias podem ser escolhidos *@
                                <input class="@(IsOutsideTrip(b.Date) ? "input out-of-range" : "input")" type="date" aria-label="Dia"
                                       min="@_event.StartDate.ToString("yyyy-MM-dd")" max="@_event.EndDate.ToString("yyyy-MM-dd")"
                                       title="@(IsOutsideTrip(b.Date) ? "Escolhe um dia das férias" : "Dia da reserva: aparece no plano dia a dia")"
                                       @bind="b.Date" @bind:format="yyyy-MM-dd" />
                                <input class="input" placeholder="Código" aria-label="Código de reserva"
                                       maxlength="@VacationPlanValidator.ReferenceMaxLength" @bind="b.Reference" />
                                <span class="money-field">
                                    <input class="input amount" type="number" min="0" step="0.01" placeholder="Valor" aria-label="Valor (€)"
                                           title="Valor (€) — entra no orçamento" @bind="b.Cost" />
                                </span>
                                <div class="link-field">
                                    <input class="input" type="url" placeholder="https://…" aria-label="Ligação"
                                           maxlength="@VacationPlanValidator.UrlMaxLength" @bind="b.Url" />
                                    @if (VacationPlanValidator.IsSafeUrl(b.Url))
                                    {
                                        <a class="btn small" href="@b.Url!.Trim()" target="_blank" rel="noopener noreferrer">Abrir</a>
                                    }
                                </div>
                                <input class="input booking-notes" placeholder="Notas" aria-label="Notas"
                                       maxlength="@VacationPlanValidator.NotesMaxLength" @bind="b.Notes" />
                                <button type="button" class="btn icon ghost" aria-label="Remover reserva" @onclick="() => Remove(_plan.Bookings, b)">✕</button>
                            </div>
                        }
                    </div>
                }
            </section>

            @* ---------- Tarefas ---------- *@
            <section class="card plan-section" aria-labelledby="tasks-title">
                <div class="section-head">
                    <h2 id="tasks-title">Tarefas</h2>
                    @if (_plan.Tasks.Count > 0)
                    {
                        <span class="muted small">@_plan.Tasks.Count(t => t.Done) de @_plan.Tasks.Count feitas</span>
                    }
                </div>

                <div class="task-add">
                    <input class="input" placeholder="Nova tarefa (ex.: renovar cartão de cidadão)" aria-label="Nova tarefa"
                           maxlength="@VacationPlanValidator.TaskMaxLength"
                           @bind="_newTask" @bind:event="oninput" @onkeydown="OnTaskKeyDown" />
                    <button type="button" class="btn small" @onclick="AddTask">Adicionar</button>
                </div>

                @if (_plan.Tasks.Count > 0)
                {
                    <ul class="plain-list task-list">
                        @foreach (var task in _plan.Tasks)
                        {
                            var t = task;
                            <li class="@(t.Done ? "task done" : "task")">
                                <input type="checkbox" aria-label="Feita" @bind="t.Done" />
                                <input class="input task-text" aria-label="Tarefa" maxlength="@VacationPlanValidator.TaskMaxLength" @bind="t.Text" />
                                <button type="button" class="btn icon ghost small" aria-label="Remover tarefa" @onclick="() => Remove(_plan.Tasks, t)">✕</button>
                            </li>
                        }
                    </ul>
                }
            </section>

            @* ---------- Orçamento ---------- *@
            <section class="card plan-section" aria-labelledby="budget-title">
                <div class="section-head">
                    <h2 id="budget-title">Orçamento</h2>
                    <button type="button" class="btn small" @onclick="AddExpense">+ Despesa</button>
                </div>

                @if (_plan.Expenses.Count == 0 && PricedBookings.Count == 0)
                {
                    <p class="muted small">Junta as despesas previstas e, depois, o que gastaste mesmo. O valor das reservas entra aqui sozinho.</p>
                }
                else
                {
                    <div class="expense-list">
                        @* Reservas com valor: contam como previsto e gasto; editam-se nas Reservas *@
                        @foreach (var booking in PricedBookings)
                        {
                            <div class="expense-row booking-expense" title="Valor da reserva: altera-o em Reservas">
                                <span class="tag">Reserva · @Pt.Label(PlanBookingDto.BudgetCategory(booking.Type))</span>
                                <span class="booking-expense-name">@booking.Name</span>
                                <span class="amount">@Pt.Money(booking.Cost!.Value)</span>
                                <span class="amount">@Pt.Money(booking.Cost!.Value)</span>
                                <span></span>
                            </div>
                        }
                        @foreach (var expense in _plan.Expenses)
                        {
                            var e = expense;
                            <div class="expense-row">
                                <select class="input" aria-label="Categoria" @bind="e.Category">
                                    @foreach (var category in Enum.GetValues<ExpenseCategory>())
                                    {
                                        <option value="@category">@Pt.Label(category)</option>
                                    }
                                </select>
                                <input class="input" placeholder="Descrição (ex.: hotel, jantar…)" aria-label="Descrição"
                                       maxlength="@VacationPlanValidator.ShortTextMaxLength" @bind="e.Description" />
                                <span class="money-field">
                                    <input class="input amount" type="number" min="0" step="0.01" placeholder="Previsto" aria-label="Previsto (€)"
                                           title="Previsto (€)" @bind="e.Planned" />
                                </span>
                                <span class="money-field">
                                    <input class="input amount" type="number" min="0" step="0.01" placeholder="Real" aria-label="Real (€)"
                                           title="Real (€)" @bind="e.Actual" />
                                </span>
                                <button type="button" class="btn icon ghost small" aria-label="Remover despesa" @onclick="() => Remove(_plan.Expenses, e)">✕</button>
                            </div>
                        }
                    </div>

                    <dl class="budget-totals">
                        <div><dt>Previsto</dt><dd>@Pt.Money(TotalPlanned)</dd></div>
                        <div><dt>Gasto</dt><dd>@Pt.Money(TotalActual)</dd></div>
                        <div>
                            <dt>@(TotalActual > TotalPlanned ? "Acima do previsto" : "Disponível")</dt>
                            <dd class="@(TotalActual > TotalPlanned ? "over" : "under")">@Pt.Money(Math.Abs(TotalPlanned - TotalActual))</dd>
                        </div>
                    </dl>
                }
            </section>

            @* ---------- Onde gastei mais (atualiza enquanto editas o orçamento e as reservas) ---------- *@
            <SpendingChart Amounts="_plan.SpentByCategory()" />

            @* ---------- Plano dia a dia ---------- *@
            <section class="card plan-section plan-wide" aria-labelledby="days-title">
                <div class="section-head">
                    <h2 id="days-title">Plano dia a dia</h2>
                </div>

                <ol class="day-plan">
                    @foreach (var day in _days)
                    {
                        var d = day;
                        <li class="@(IsWeekend(d.Date) ? "day-card weekend" : "day-card")">
                            <div class="day-date">
                                <strong>@Pt.Long(d.Date)</strong>
                                <span class="muted small">Dia @(d.Date.DayNumber - _event.StartDate.DayNumber + 1)</span>
                            </div>
                            @{ var dayBookings = BookingsOn(d.Date); }
                            @if (dayBookings.Count > 0)
                            {
                                <ul class="plain-list day-bookings" aria-label="Reservas neste dia">
                                    @foreach (var booking in dayBookings)
                                    {
                                        <li>
                                            <span class="tag">@Pt.Label(booking.Type)</span>
                                            <span class="day-booking-name">@booking.Name</span>
                                            @if (!string.IsNullOrWhiteSpace(booking.Reference))
                                            {
                                                <span class="muted small">@booking.Reference</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                            @{ var dayPlaces = PlacesOn(d.Date); }
                            @if (dayPlaces.Count > 0)
                            {
                                <ul class="plain-list day-bookings" aria-label="Locais a visitar neste dia">
                                    @foreach (var (place, number) in dayPlaces)
                                    {
                                        <li class="@(place.Visited ? "day-place visited" : "day-place")">
                                            <span class="place-number small-pin">@number</span>
                                            <span class="day-booking-name">@place.Name</span>
                                        </li>
                                    }
                                </ul>
                            }
                            <input class="input" placeholder="Onde? (ex.: Lagos)" aria-label="Local"
                                   maxlength="@VacationPlanValidator.ShortTextMaxLength" @bind="d.Place" />
                            <textarea class="input" rows="2" placeholder="Atividades, restaurantes, horários…" aria-label="Atividades"
                                      maxlength="@VacationPlanValidator.ActivitiesMaxLength" @bind="d.Activities"></textarea>
                        </li>
                    }
                </ol>
            </section>
        </div>

        <div class="plan-footer">
            <button type="button" class="btn primary" disabled="@_saving" @onclick="SaveAsync">
                @(_saving ? "A guardar…" : "Guardar")
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private CalendarEventDto? _event;
    private VacationPlanDto? _plan;
    private List<PlanDayDto> _days = [];
    private string? _loadError;
    private List<string> _errors = [];
    private string _newTask = "";
    private string? _savedState;
    private bool _saving;
    private bool _saved;

    /// <summary>
    /// Há alterações por guardar quando o conteúdo atual difere do último que
    /// foi carregado ou guardado. Comparar o estado apanha qualquer campo, sem
    /// depender de eventos (o "change" não sobe aos elementos pai no Blazor).
    /// </summary>
    private bool IsDirty => _plan is not null && CurrentState() != _savedState;

    private string CurrentState() =>
        JsonSerializer.Serialize(new { _plan!.Destination, _plan.Bookings, _plan.Tasks, _plan.Expenses, _plan.Places, Days = _days });

    private List<PlanBookingDto> PricedBookings =>
        _plan?.Bookings.Where(b => b.Cost > 0).ToList() ?? [];

    private decimal BookingsTotal => PricedBookings.Sum(b => b.Cost ?? 0);

    // As reservas já estão pagas/comprometidas: contam no previsto e no gasto
    private decimal TotalPlanned => (_plan?.Expenses.Sum(e => e.Planned ?? 0) ?? 0) + BookingsTotal;
    private decimal TotalActual => (_plan?.Expenses.Sum(e => e.Actual ?? 0) ?? 0) + BookingsTotal;

    protected override async Task OnParametersSetAsync()
    {
        _event = null;
        _plan = null;
        _loadError = null;
        _saved = false;

        try
        {
            var eventTask = Api.GetEventAsync(Id);
            var planTask = Api.GetPlanAsync(Id);
            _event = await eventTask;
            _plan = await planTask;
            BuildDays();
            _savedState = CurrentState();
        }
        catch (Exception ex)
        {
            _loadError = $"Não foi possível carregar o planeamento. {ex.Message}";
        }
    }

    /// <summary>Um bloco por cada dia das férias, com o que já estava guardado.</summary>
    private void BuildDays()
    {
        var saved = _plan!.Days.ToDictionary(d => d.Date);
        _days = [];
        for (var date = _event!.StartDate; date <= _event.EndDate; date = date.AddDays(1))
            _days.Add(saved.GetValueOrDefault(date) ?? new PlanDayDto { Date = date });
    }

    private void AddBooking() => _plan!.Bookings.Add(new PlanBookingDto { Date = _event!.StartDate });

    private void AddExpense() => _plan!.Expenses.Add(new PlanExpenseDto());

    private void AddTask()
    {
        if (string.IsNullOrWhiteSpace(_newTask))
            return;

        _plan!.Tasks.Add(new PlanTaskDto { Text = _newTask.Trim() });
        _newTask = "";
    }

    private void OnTaskKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            AddTask();
    }

    private static void Remove<T>(List<T> list, T item) => list.Remove(item);

    private async Task SaveAsync()
    {
        if (_plan is null)
            return;

        // Linhas deixadas em branco não contam como erro: são simplesmente ignoradas
        _plan.Tasks.RemoveAll(t => string.IsNullOrWhiteSpace(t.Text));
        _plan.Bookings.RemoveAll(b => string.IsNullOrWhiteSpace(b.Name) && string.IsNullOrWhiteSpace(b.Reference)
                                      && string.IsNullOrWhiteSpace(b.Url) && string.IsNullOrWhiteSpace(b.Notes)
                                      && b.Cost is null);
        _plan.Expenses.RemoveAll(e => string.IsNullOrWhiteSpace(e.Description) && e.Planned is null && e.Actual is null);
        _plan.Days = _days.Where(d => !string.IsNullOrWhiteSpace(d.Place) || !string.IsNullOrWhiteSpace(d.Activities)).ToList();

        _errors = VacationPlanValidator.Validate(_plan, _event!.StartDate, _event.EndDate).SelectMany(kv => kv.Value).ToList();
        if (_errors.Count > 0)
            return;

        _saving = true;
        try
        {
            _plan = await Api.SavePlanAsync(Id, _plan);
            BuildDays();
            _savedState = CurrentState();
            _saved = true;
        }
        catch (Exception ex)
        {
            _errors = [ex.Message];
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        if (IsDirty && !await JS.InvokeAsync<bool>("confirm", "Tens alterações por guardar. Sair sem guardar?"))
            context.PreventNavigation();
    }

    /// <summary>Reservas marcadas para este dia (as que ainda não têm nome ficam de fora).</summary>
    private List<PlanBookingDto> BookingsOn(DateOnly date) =>
        _plan?.Bookings.Where(b => b.Date == date && !string.IsNullOrWhiteSpace(b.Name)).ToList() ?? [];

    /// <summary>Locais marcados para este dia, com o número que têm no mapa.</summary>
    private List<(PlanPlaceDto Place, int Number)> PlacesOn(DateOnly date) =>
        _plan?.Places.Select((p, i) => (p, i + 1)).Where(x => x.p.Date == date).ToList() ?? [];

    private bool IsOutsideTrip(DateOnly? date) =>
        date is { } d && _event is not null && (d < _event.StartDate || d > _event.EndDate);

    private static bool IsWeekend(DateOnly date) => date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
}
